---
// Muestrario del sistema de diseño: colores, tipografía y componentes en un
// solo sitio, para revisarlos juntos y para la defensa del proyecto.
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Entry from "../components/Entry.astro";
import Figure from "../components/Figure.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import Logo from "../components/Logo.astro";
import MarginNote from "../components/MarginNote.astro";

const colors = [
  ["--paper", "Papel", "Fondo de la página"],
  ["--sheet", "Hoja", "Tarjetas y formularios"],
  ["--ink", "Tinta", "Texto principal"],
  ["--ink-soft", "Lápiz", "Texto secundario"],
  ["--accent", "Rotulador", "Una acción por pantalla y anotaciones"],
  ["--link", "Tinta azul", "Enlaces"],
  ["--mark", "Fluorescente", "Resaltar"],
  ["--grid", "Cuadrícula", "Decorativo"],
];

const steps = [
  ["--step-4", "Título de página"],
  ["--step-3", "Entrada"],
  ["--step-2", "Subtítulo"],
  ["--step-1", "Destacado"],
  ["--step-0", "Texto"],
  ["--step--1", "Etiqueta"],
];

const contactFlow = {
  title:
    "Recorrido de un mensaje de contacto: formulario, n8n, clasificación con IA, Supabase y email de respuesta.",
  nodes: [
    { id: "form", label: "Formulario", x: 72, y: 110 },
    { id: "n8n", label: "n8n", x: 232, y: 110 },
    { id: "ai", label: "IA clasifica", x: 400, y: 50, accent: true },
    { id: "db", label: "Supabase", x: 400, y: 170 },
    { id: "mail", label: "Email", x: 566, y: 110 },
  ],
  edges: [
    ["form", "n8n"],
    ["n8n", "ai"],
    ["n8n", "db"],
    ["ai", "mail"],
    ["db", "mail"],
  ] as [string, string][],
};

// Esquemas de la defensa (docs/defensa.md): el mismo recorrido paso a paso y
// cómo filtra RLS lo que pide Mi espacio
const dataFlow = {
  title:
    "Del formulario al correo: el navegador envía a n8n, n8n comprueba el captcha, crea el usuario en Supabase, la IA clasifica, se guarda el mensaje y se envía el correo.",
  nodes: [
    { id: "form", label: "1 · Formulario", x: 150, y: 30 },
    { id: "n8n", label: "2 · n8n valida", x: 150, y: 100 },
    { id: "captcha", label: "3 · Captcha", x: 150, y: 170 },
    { id: "auth", label: "4 · Crea el usuario", x: 150, y: 240 },
    { id: "ai", label: "5 · IA clasifica", x: 150, y: 310, accent: true },
    { id: "db", label: "6 · Guarda el mensaje", x: 150, y: 380 },
    { id: "mail", label: "7 · Correo", x: 150, y: 450 },
  ],
  edges: [
    ["form", "n8n"],
    ["n8n", "captcha"],
    ["captcha", "auth"],
    ["auth", "ai"],
    ["ai", "db"],
    ["db", "mail"],
  ] as [string, string][],
  direction: "vertical" as const,
  width: 300,
  height: 480,
  minWidth: "16rem",
};

const rlsFlow = {
  title:
    "Cómo protege RLS Mi espacio: la web pide los mensajes con su JWT, Postgres aplica las reglas y devuelve solo el hilo de esa persona, o todos si es el admin.",
  nodes: [
    { id: "web", label: "Mi espacio + JWT", x: 80, y: 110 },
    { id: "api", label: "API REST", x: 240, y: 110 },
    { id: "rls", label: "Postgres + RLS", x: 400, y: 110, accent: true },
    { id: "own", label: "user_id = auth.uid()", x: 600, y: 50 },
    { id: "all", label: "is_admin() → todos", x: 600, y: 170 },
  ],
  edges: [
    ["web", "api"],
    ["api", "rls"],
    ["rls", "own"],
    ["rls", "all"],
  ] as [string, string][],
  width: 720,
};
---

<Base lang="es" title="Sistema de diseño" noindex>
  <div class="wrap">
    <header class="intro">
      <p class="label">Cuaderno nº 3 · Anexo A</p>
      <h1>Sistema de diseño</h1>
      <p class="lead">
        Un cuaderno de laboratorio: papel cuadriculado, tinta, un rotulador rojo y diagramas
        dibujados a mano. Aquí están todas las piezas que usa la web.
      </p>
    </header>

    <Entry id="marca" number={1} kicker="Marca" title="Logo">
      <MarginNote label="Por qué">
        La M de Marc dibujada como un flujo de cinco nodos. El nodo rojo del centro es la IA:
        el punto donde el trabajo aburrido cambia de manos.
      </MarginNote>
      <div class="logos">
        <Logo size={96} />
        <Logo size={48} />
        <Logo size={24} />
      </div>
    </Entry>

    <Entry id="color" number={2} kicker="Color" title="Paleta" meta="Todos los textos pasan AA">
      <ul class="swatches" role="list">
        {
          colors.map(([token, name, use]) => (
            <li>
              <span class="chip" style={`background: var(${token})`} />
              <strong>{name}</strong>
              <code>{token}</code>
              <span class="use">{use}</span>
            </li>
          ))
        }
      </ul>
    </Entry>

    <Entry id="tipo" number={3} kicker="Tipografía" title="Newsreader y JetBrains Mono">
      <MarginNote label="Por qué">
        Una serif de periódico para leer a gusto y una mono para los datos, como las anotaciones
        a máquina de un cuaderno técnico. Solo dos familias, servidas desde la web.
      </MarginNote>
      <ul class="scale" role="list">
        {
          steps.map(([token, use]) => (
            <li>
              <span class="label">{token}</span>
              <span style={`font-size: var(${token})`}>{use}: aprendo IA para dar vida a proyectos</span>
            </li>
          ))
        }
      </ul>
      <p>
        Texto corrido con <a href="#tipo">un enlace</a>, <em>una cursiva</em>,
        <mark>algo resaltado</mark>, <code>código</code> y un atajo <kbd>⌘</kbd> <kbd>K</kbd>.
      </p>
    </Entry>

    <Entry id="componentes" number={4} kicker="Componentes" title="Piezas reutilizables">
      <div class="buttons">
        <Button href="#componentes">Ponte en contacto conmigo</Button>
        <Button href="#componentes" variant="ghost">Ver el caso</Button>
      </div>
      <Figure number={1} caption="Recorrido de un mensaje de contacto (bloque #30).">
        <FlowDiagram {...contactFlow} />
      </Figure>
    </Entry>

    <Entry id="defensa" number={5} kicker="Defensa" title="Dos recorridos en un minuto">
      <MarginNote label="La idea">
        Todo lo que llega al navegador lo puede leer cualquiera. Lo que pide una clave secreta
        pasa por n8n; lo que va con la pública lo vigila la base de datos.
      </MarginNote>
      <div class="defensa">
        <Figure number={2} caption="Del formulario al correo (flujo «mi-web · Contacto»).">
          <FlowDiagram {...dataFlow} />
        </Figure>
        <ol class="pasos">
          <li>La web envía el formulario con <code>fetch</code> al webhook de n8n.</li>
          <li>n8n lo vuelve a validar: al webhook se le puede llamar sin la web.</li>
          <li>Comprueba el captcha con la clave secreta, que solo tiene n8n.</li>
          <li>Crea el usuario en Supabase Auth; un trigger le crea el perfil.</li>
          <li>Claude pone una de cinco categorías; si falla, se guarda igual.</li>
          <li>Guarda el mensaje y el evento en Supabase.</li>
          <li>Si no es spam, envía el correo con el enlace a <code>/entrar/</code>.</li>
        </ol>
      </div>
      <Figure number={3} caption="Cómo protege RLS los datos de Mi espacio.">
        <FlowDiagram {...rlsFlow} />
      </Figure>
      <p>
        La web pide «los mensajes» sin filtro. Postgres mira quién firma el JWT y aplica la
        regla antes de responder: cada persona recibe su hilo y yo, como <code>admin</code>, todos.
        Aunque alguien cambie el JavaScript, no ve más.
        Lo comprueban 39 pruebas de <code>supabase/tests/rls.sql</code>.
      </p>
    </Entry>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-4);
  }

  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .logos {
    display: flex;
    align-items: end;
    gap: var(--space-4);
    color: var(--ink);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-2);
    padding: 0;
  }

  .swatches li {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-2);
    background: var(--sheet);
    border: 1px solid var(--rule);
  }

  .chip {
    height: 3.5rem;
    margin-block-end: var(--space-1);
    border: 1px solid var(--rule);
  }

  .use {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .scale {
    display: grid;
    gap: var(--space-2);
    padding: 0;
  }

  .scale li {
    display: grid;
    gap: 0.2rem;
    max-width: none;
    line-height: 1.15;
  }

  .defensa {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    margin-block-end: var(--space-5);
  }

  @media (min-width: 48rem) {
    .defensa {
      grid-template-columns: minmax(16rem, 20rem) 1fr;
    }
  }

  .pasos {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: 1.4em;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
  }
</style>
