---
import Base from "../layouts/Base.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("es");
---

<Base lang="es">
  <div class="wrap wip">
    <p class="label">Cuaderno nº 3</p>
    <h1>{t("wip.title")}</h1>
    <p>{t("wip.body")}</p>
  </div>
</Base>

<style>
  .wip {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-7);
  }
</style>
