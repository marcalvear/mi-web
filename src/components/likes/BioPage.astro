---
// Biohacking (#71): el radar de aparatos, con la entrada grande al compendio
// arriba. Los suplementos van en el compendio, no aquí.
import Base from "../../layouts/Base.astro";
import Biohacking from "./Biohacking.astro";
import CompendioTeaser from "../compendio/CompendioTeaser.astro";
import { hobbies } from "../../i18n/hobbies";
import { likes } from "../../i18n/likes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = hobbies[lang].bio;
const bio = likes[lang].bio;
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="me-gusta/biohacking/">
  <div class="wrap">
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <CompendioTeaser lang={lang} text={bio.teaser} level={2} />

    <section class="radar" id="radar" aria-labelledby="radar-title">
      <p class="label">{bio.kicker}</p>
      <h2 id="radar-title">{bio.title}</h2>
      <p class="radar-intro">{bio.intro}</p>
      <Biohacking text={bio} />
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-2);
  }

  .lead {
    max-width: 44ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .radar {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5) var(--space-7);
    border-top: 1px dashed var(--rule);
  }

  .radar > .label {
    color: var(--accent);
  }

  .radar h2 {
    font-size: var(--step-3);
  }

  .radar-intro {
    max-width: var(--measure);
  }
</style>
