---
// Videojuegos (#71): los tres juegos como tres «cartuchos» arriba y una
// sección por juego, cada una con su tono: Zelda verde y luminoso,
// Bloodborne a oscuras y Pokémon rojo. La Pokédex va en la de Pokémon.
import { Picture } from "astro:assets";
import Ampliable from "../Ampliable.astro";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Pokedex from "./Pokedex.astro";
import { hobbies } from "../../i18n/hobbies";
import { likes } from "../../i18n/likes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = hobbies[lang].games;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/img/me-gusta/*.webp", { eager: true });
const photo = (file: string) => photos[`../../assets/img/me-gusta/${file}.webp`]!.default;
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="me-gusta/videojuegos/">
  <div class="wrap">
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <nav class="cartridges" aria-label={c.navLabel}>
      <ul role="list">
        {
          c.items.map((g, i) => (
            <li>
              <a class="cartridge" href={`#${g.id}`} data-game={g.id}>
                <span class="label slot">{String(i + 1).padStart(2, "0")}</span>
                <span class="name">{g.short}</span>
                <span class="label sub">{g.kicker}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      c.items.map((g, i) => (
        <section class="game" id={g.id} data-game={g.id} aria-labelledby={`${g.id}-title`}>
          <figure class="hero">
            <Ampliable src={photo(g.hero.file)} alt={g.hero.alt} caption={g.credit} lang={lang}>
              <Picture
                src={photo(g.hero.file)}
                alt={g.hero.alt}
                formats={["avif", "webp"]}
                widths={[480, 768, 1024, 1600]}
                sizes="(min-width: 72rem) 70rem, 94vw"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : "auto"}
              />
            </Ampliable>
            <figcaption class="credit">{g.credit}</figcaption>
          </figure>

          <div class="body">
            <div class="copy">
              <p class="label kicker">{g.kicker}</p>
              <h2 id={`${g.id}-title`}>{g.name}</h2>
              {g.text.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            <dl class="facts">
              {g.facts.map(([k, v]) => (
                <div>
                  <dt class="label">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
              {g.hours && (
                <div>
                  <dt class="label">{c.factLabels.hours}</dt>
                  <dd>{g.hours}</dd>
                </div>
              )}
              {g.moment && (
                <div class="wide">
                  <dt class="label">{c.factLabels.moment}</dt>
                  <dd>{g.moment}</dd>
                </div>
              )}
            </dl>
          </div>

          <ul class="strip" role="list">
            {g.strip.map((s) => (
              <li>
                <Ampliable src={photo(s.file)} alt={s.alt} lang={lang}>
                  <Picture
                    src={photo(s.file)}
                    alt={s.alt}
                    formats={["avif", "webp"]}
                    widths={[400, 800]}
                    sizes="(min-width: 72rem) 23rem, (min-width: 48rem) 31vw, 47vw"
                    loading="lazy"
                  />
                </Ampliable>
              </li>
            ))}
          </ul>

          {g.id === "pokemon" && (
            <section class="pokedex" id="pokedex" aria-labelledby="pokedex-title">
              <h3 id="pokedex-title">{c.pokedexTitle}</h3>
              <p>{c.pokedexIntro}</p>
              <Pokedex lang={lang} text={likes[lang].pokedex} />
            </section>
          )}
        </section>
      ))
    }

    <p class="note">{c.creditsNote}</p>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-3);
  }

  .lead {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  /* Tonos de cada juego: Bloodborne lleva los suyos porque va a oscuras */
  [data-game="zelda"] {
    --tone: var(--zelda);
    --tone-soft: var(--zelda-soft);
  }

  [data-game="pokemon"] {
    --tone: var(--pokemon);
    --tone-soft: var(--pokemon-soft);
  }

  [data-game="bloodborne"] {
    --tone: #c9a86a;
    --tone-soft: #1d1922;
  }

  /* Tres cartuchos: la etiqueta de color arriba y la muesca del conector */
  .cartridges ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .cartridge {
    position: relative;
    display: grid;
    gap: 0.3rem;
    min-height: 44px;
    padding: var(--space-3) var(--space-2) var(--space-2);
    border: 1.5px solid var(--ink);
    border-top: 10px solid var(--tone);
    border-radius: var(--radius) var(--radius) 10px 10px;
    background: var(--sheet);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--rule);
    transition:
      transform var(--fast) var(--ease-out),
      box-shadow var(--fast) var(--ease-out);
  }

  .cartridge[data-game="bloodborne"] {
    background: #121016;
    color: #e9e2d4;
  }

  /* La muesca de abajo, como el conector de un cartucho */
  .cartridge::after {
    content: "";
    position: absolute;
    inset-block-end: -1.5px;
    inset-inline: 30%;
    height: 6px;
    border: 1.5px solid var(--ink);
    border-bottom: 0;
    background: var(--paper);
  }

  /* Solo con ratón: en el móvil se quedaba puesto tras tocar (#79) */
  @media (hover: hover) and (pointer: fine) {
    .cartridge:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--tone);
    }
  }

  /* En móvil, los tres en fila y sin el subtítulo, para no tapar la pantalla */
  @media (max-width: 39.99rem) {
    .cartridges ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-1);
    }

    .cartridge {
      padding: var(--space-2) var(--space-1) var(--space-1);
      border-top-width: 8px;
    }

    .cartridge .name {
      font-size: var(--step-0);
    }

    .cartridge .sub {
      display: none;
    }
  }

  .slot {
    color: var(--tone);
  }

  .name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
  }

  .sub {
    color: inherit;
    opacity: 0.8;
  }

  /* Cada juego */
  .game {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
    padding-block-start: var(--space-4);
    border-top: 1px dashed var(--rule);
    scroll-margin-top: var(--space-3);
  }

  /* Lo que no se ve al entrar no se pinta (ni descarga sus fotos) hasta que
     te acercas: la página llega antes con conexiones lentas */
  .game + .game {
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }

  /* Bloodborne a oscuras en los dos temas, como Yharnam de noche */
  .game[data-game="bloodborne"] {
    padding: var(--space-4) var(--space-3);
    border: 1.5px solid #000;
    background: #121016;
    color: #e9e2d4;
    box-shadow: 6px 6px 0 #5a1414;
  }

  .hero {
    margin: 0;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: #000;
  }

  .hero :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .credit {
    padding: 0.3rem var(--space-1);
    background: var(--sheet);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  [data-game="bloodborne"] .credit {
    background: #1d1922;
    color: #b9b1a3;
  }

  .body {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 52rem) {
    .body {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
  }

  .copy {
    display: grid;
    gap: var(--space-1);
  }

  .kicker {
    color: var(--tone);
  }

  .copy h2 {
    font-size: var(--step-3);
    line-height: 1.05;
  }

  .copy p:not(.kicker) {
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* La ficha del juego, como una etiqueta pegada al lado */
  .facts {
    display: grid;
    gap: 1px;
    margin: 0;
    border: 1.5px solid var(--tone);
    background: var(--tone);
  }

  .facts div {
    display: grid;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
    background: var(--tone-soft);
  }

  .facts dt {
    color: var(--tone);
  }

  .facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  /* Galería de capturas: dos columnas en el móvil y tres a partir de la
     tableta, para que 6 u 8 capturas formen filas completas */
  .strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .strip li {
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: #000;
  }

  @media (min-width: 48rem) {
    .strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  [data-game="bloodborne"] .strip li,
  [data-game="bloodborne"] .hero {
    border-color: #3a3340;
  }

  .strip :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .strip li:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .pokedex {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-top: 1px dashed var(--rule);
    scroll-margin-top: var(--space-3);
  }

  .pokedex h3 {
    font-size: var(--step-2);
    color: var(--tone);
  }

  .note {
    margin-block-end: var(--space-7);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .cartridge,
    .strip :global(img) {
      transition: none;
    }
  }
</style>
