---
// Anime y manga (#71): cada obra es una página de manga. Viñetas de borde
// grueso y distinto tamaño, una de texto con trama de puntos y las cartelas
// con el título de cada ilustración. Al final, el mazo de frases.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import QuoteDeck from "./QuoteDeck.astro";
import { hobbies } from "../../i18n/hobbies";
import { likes } from "../../i18n/likes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = hobbies[lang].anime;
const deck = likes[lang].deck;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/img/me-gusta/*.webp", { eager: true });
const photo = (file: string) => photos[`../../assets/img/me-gusta/${file}.webp`]!.default;
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="me-gusta/anime-manga/">
  <div class="wrap">
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    {
      c.items.map((s) => (
        <section class="series" id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="page" data-series={s.id}>
            {s.panels.map((p, j) => (
              <figure class={`panel img p${j}`}>
                <Picture
                  src={photo(p.file)}
                  alt={p.alt}
                  formats={["avif", "webp"]}
                  widths={j === 0 ? [480, 800, 1200] : [360, 720]}
                  sizes={j === 0 ? "(min-width: 72rem) 36rem, 94vw" : "(min-width: 72rem) 24rem, 94vw"}
                  loading="lazy"
                  decoding="async"
                />
                {p.caption && <figcaption class="caption">{p.caption}</figcaption>}
              </figure>
            ))}

            <div class="panel text">
              <p class="label kicker">{s.kicker}</p>
              <h2 id={`${s.id}-title`}>{s.name}</h2>
              {s.text.map((t) => (
                <p>{t}</p>
              ))}
              <dl class="facts">
                {s.facts.map(([k, v]) => (
                  <div>
                    <dt class="label">{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
                {s.arc && (
                  <div>
                    <dt class="label">{c.factLabels.arc}</dt>
                    <dd>{s.arc}</dd>
                  </div>
                )}
                {s.character && (
                  <div>
                    <dt class="label">{c.factLabels.character}</dt>
                    <dd>{s.character}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
          <p class="credit">{s.credit}</p>
        </section>
      ))
    }

    <section class="deck-section" id="frases" aria-labelledby="frases-title">
      <p class="label">{deck.kicker}</p>
      <h2 id="frases-title">{deck.title}</h2>
      <p class="deck-intro">{deck.intro}</p>
      <QuoteDeck lang={lang} text={deck} />
    </section>

    <p class="note">{c.creditsNote}</p>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-4);
  }

  .lead {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .series {
    margin-block-end: var(--space-6);
    scroll-margin-top: var(--space-3);
  }

  /* Lo que no se ve al entrar no se pinta (ni descarga sus fotos) hasta que
     te acercas: la página llega antes con conexiones lentas */
  .series + .series,
  .deck-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 1100px;
  }

  /* La página: fondo blanco, márgenes de imprenta y viñetas con calles */
  .page {
    --gutter: 10px;
    --ink-line: #111;
    display: grid;
    gap: var(--gutter);
    padding: var(--gutter);
    background: #fdfcf8;
    border: 1px solid var(--rule);
    box-shadow: 6px 6px 0 var(--rule);
  }

  .panel {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 3px solid var(--ink-line);
    background: #fff;
  }

  /* La imagen rellena la viñeta sin imponer su alto: lo decide la rejilla */
  .img :global(picture) {
    position: absolute;
    inset: 0;
  }

  .img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .img :global(img) {
    object-fit: cover;
    object-position: center 25%;
    transition: transform var(--slow) var(--ease-out);
  }

  .img:hover :global(img) {
    transform: scale(1.04);
  }

  /* La cartela de cada viñeta, como el recuadro del narrador */
  .caption {
    position: absolute;
    z-index: 1;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    max-width: calc(100% - 16px);
    padding: 0.15rem 0.5rem;
    border: 2px solid var(--ink-line);
    background: #fff;
    color: #111;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* La viñeta de texto lleva trama de puntos, como el tramado del manga.
     Siempre en papel claro: la página de manga no cambia con el tema */
  .text {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-3);
    background-color: #fff;
    background-image: radial-gradient(#d9d4c7 1px, transparent 1.2px);
    background-size: 7px 7px;
    color: #111;
  }

  .text > * {
    position: relative;
  }

  .kicker {
    color: #b3261e;
  }

  .text h2 {
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .text p:not(.kicker) {
    max-width: 52ch;
    padding: var(--space-1) var(--space-2);
    background: #fff;
    border: 2px solid #111;
    border-radius: 18px;
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 6px;
    margin: var(--space-1) 0 0;
  }

  .facts div {
    padding: 0.4rem 0.6rem;
    border: 2px solid #111;
    background: #fff;
  }

  .facts dt {
    color: #4a4f5c;
  }

  .facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  /* Naruto: viñeta alta a la izquierda; texto y viñeta a la derecha; dos abajo */
  [data-series="naruto"] {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  [data-series="naruto"] .p0 {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
    aspect-ratio: 1200 / 1690;
  }

  [data-series="naruto"] .text {
    grid-column: 4 / 7;
    grid-row: 1;
  }

  [data-series="naruto"] .p1 {
    grid-column: 4 / 7;
    grid-row: 2;
    min-height: 10rem;
  }

  [data-series="naruto"] .p2 {
    grid-column: 1 / 3;
    grid-row: 3;
    aspect-ratio: 4 / 5;
  }

  [data-series="naruto"] .p3 {
    grid-column: 3 / 7;
    grid-row: 3;
    min-height: 10rem;
  }

  [data-series="naruto"] .p3 :global(img) {
    object-position: center 15%;
  }

  /* JoJo: viñeta panorámica arriba, texto y dos viñetas debajo */
  [data-series="jojo"] {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  [data-series="jojo"] .p0 {
    grid-column: 1 / -1;
    aspect-ratio: 1600 / 867;
  }

  [data-series="jojo"] .text {
    grid-column: 1 / 4;
    grid-row: 2;
  }

  [data-series="jojo"] .p1 {
    grid-column: 4 / 7;
    grid-row: 2 / 4;
    min-height: 10rem;
  }

  [data-series="jojo"] .p2 {
    grid-column: 1 / 4;
    grid-row: 3;
    aspect-ratio: 700 / 600;
  }

  [data-series="jojo"] .p2 :global(img) {
    object-fit: contain;
  }

  /* En móvil, una viñeta debajo de otra */
  @media (max-width: 47.99rem) {
    .page[data-series] {
      grid-template-columns: 1fr;
    }

    .page[data-series] > * {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }

    .page[data-series] .p1,
    .page[data-series] .p3 {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    [data-series="naruto"] .p0 {
      aspect-ratio: 4 / 5;
    }

    [data-series="naruto"] .text {
      order: -1;
    }

    [data-series="jojo"] .p1 {
      min-height: 0;
      aspect-ratio: 3 / 4;
    }

    /* La panorámica primero y el texto justo debajo */
    [data-series="jojo"] .p1,
    [data-series="jojo"] .p2 {
      order: 1;
    }
  }

  .credit {
    margin-block-start: var(--space-1);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .deck-section {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px dashed var(--rule);
    scroll-margin-top: var(--space-3);
  }

  .deck-section > .label {
    color: var(--accent);
  }

  .deck-section h2 {
    font-size: var(--step-3);
  }

  .deck-intro {
    max-width: var(--measure);
  }

  .note {
    margin-block-end: var(--space-7);
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .img :global(img) {
      transition: none;
    }
  }
</style>
