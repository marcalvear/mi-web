---
// Me gusta (#71): el índice de las tres aficiones. Cada una tiene su página;
// aquí van las mismas tarjetas que en la portada.
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import HobbyCards from "./HobbyCards.astro";
import { home } from "../../i18n/home";
import { likes } from "../../i18n/likes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = likes[lang];
const h = home[lang].likes;
// Antes todo estaba en esta página: los enlaces viejos con #ancla llevan a la nueva
const moved = {
  pokedex: getRelativeLocaleUrl(lang, "me-gusta/videojuegos/") + "#pokedex",
  frases: getRelativeLocaleUrl(lang, "me-gusta/anime-manga/") + "#frases",
  biohacking: getRelativeLocaleUrl(lang, "me-gusta/biohacking/"),
};
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="me-gusta/">
  <div class="wrap" data-moved={JSON.stringify(moved)}>
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <HobbyCards lang={lang} groups={h.groups} open={h.open} level={2} />
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-moved]");
  const to = root && (JSON.parse(root.dataset.moved!) as Record<string, string>)[location.hash.slice(1)];
  if (to) location.replace(to);
</script>

<style>
  .wrap {
    padding-block-end: var(--space-7);
  }

  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-2);
  }

  .lead {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }
</style>
