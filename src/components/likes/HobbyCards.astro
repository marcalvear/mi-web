---
// Las tres aficiones (#71): cada tarjeta lleva a su página. Va en la portada
// y en /me-gusta/. El enlace es el título, pero se estira para cubrir toda la
// tarjeta: el lector de pantalla oye solo el título, y se puede pulsar en
// cualquier parte.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HomeContent } from "../../i18n/home";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  groups: HomeContent["likes"]["groups"];
  open: string;
  /** h3 en la portada (va dentro de una entrada); h2 en /me-gusta/ */
  level?: 2 | 3;
}
const { lang, groups, open, level = 3 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/img/{me-gusta,biohacking}/*.webp", {
  eager: true,
});
const photo = (name: string) => photos[`../../assets/img/${name}.webp`]?.default;
---

<ul class="cards" role="list">
  {
    groups.map((group) => {
      const img = photo(group.image);
      return (
        <li class="card" data-slug={group.slug}>
          <div class="photo">
            {img && (
              <Picture
                src={img}
                alt=""
                formats={["avif", "webp"]}
                widths={[400, 800]}
                sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 90vw"
                loading="lazy"
              />
            )}
          </div>
          <p class="label tag">{group.label}</p>
          <Heading class="title">
            <a href={getRelativeLocaleUrl(lang, `me-gusta/${group.slug}/`)}>{group.title}</a>
          </Heading>
          <p>{group.text}</p>
          <ul role="list" class="items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="label open" aria-hidden="true">
            {open} <span class="arrow">→</span>
          </p>
        </li>
      );
    })
  }
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-4);
    padding: 0;
  }

  .card {
    position: relative;
    display: grid;
    /* foto, título, texto, lista (se estira) y enlace; la etiqueta va aparte */
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--space-1);
    max-width: none;
    padding: var(--space-2) var(--space-2) var(--space-3);
    background: var(--sheet);
    border: 1px solid var(--rule);
    transition:
      transform var(--mid) var(--ease-out),
      box-shadow var(--mid) var(--ease-out);
  }

  /* Cada muestra cae un poco torcida, como fichas sueltas */
  .card:nth-child(1) { rotate: -0.6deg; }
  .card:nth-child(2) { rotate: 0.5deg; }
  .card:nth-child(3) { rotate: -0.3deg; }

  /* Al pasar por encima se levanta, y la foto se acerca un poco. Con el
     teclado también; el hover, solo con ratón, que en el móvil se quedaba
     puesto tras tocar (#79) */
  .card:focus-within {
    transform: translateY(-6px);
    box-shadow: 5px 8px 0 var(--rule);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-6px);
      box-shadow: 5px 8px 0 var(--rule);
    }

    .card:hover .photo :global(img) {
      transform: scale(1.06);
    }

    .card:hover .arrow {
      transform: translateX(4px);
    }
  }

  .photo {
    aspect-ratio: 16 / 10;
    margin-block-end: var(--space-1);
    overflow: hidden;
    background: var(--photo);
    border: 1px solid var(--rule);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform var(--slow) var(--ease-out);
  }

  .card:focus-within .photo :global(img) {
    transform: scale(1.06);
  }

  .tag {
    position: absolute;
    inset-block-start: -0.8rem;
    inset-inline-start: var(--space-3);
    z-index: 1;
    padding: 0.15rem 0.6rem;
    background: var(--paper);
    border: 1.5px solid var(--accent);
    color: var(--accent);
  }

  .title {
    font-size: var(--step-2);
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* El enlace del título cubre toda la tarjeta */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .card:focus-within {
    outline: 2px solid var(--link);
    outline-offset: 4px;
  }

  /* La fila de la lista se estira para alinear los enlaces de abajo, pero
     las líneas de la lista no: van juntas arriba (#77) */
  .items {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    margin-block-start: var(--space-1);
    padding: 0;
  }

  .items li {
    padding-inline-start: 1.2em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: linear-gradient(var(--accent), var(--accent)) 0 0.7em / 0.6em 1.5px no-repeat;
  }

  .open {
    margin-block-start: var(--space-2);
    color: var(--link);
  }

  .arrow {
    display: inline-block;
    transition: transform var(--fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .photo :global(img),
    .arrow {
      transition: none;
    }
  }
</style>
