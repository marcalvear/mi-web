---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { palette } from "../i18n/palette";
import { languages, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Ruta de la página actual sin idioma, para enlazar su traducción. */
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang);
const links = [
  { href: `${home}#sobre-mi`, text: t("nav.about") },
  { href: `${home}#hecho`, text: t("nav.work") },
  { href: `${home}#me-gusta`, text: t("nav.likes") },
  // La única página propia del menú: el resto son secciones de la portada
  { href: getRelativeLocaleUrl(lang, "biohacking/"), text: t("nav.compendio"), current: path === "biohacking/" },
  { href: `${home}#contacto`, text: t("nav.contact") },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home} aria-label={t("nav.home")}>
      <Logo size={30} />
      <span class="brand-name" aria-hidden="true">Marc Calatayud</span>
    </a>

    <nav class="nav" aria-label={t("nav.label")}>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.text}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <ul class="langs" role="list" aria-label={t("lang.label")}>
        {(Object.keys(languages) as Lang[]).map((code) => (
          <li>
            <a
              class="label"
              href={getRelativeLocaleUrl(code, path)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? "page" : undefined}
            >
              <span aria-hidden="true">{code}</span>
              <span class="visually-hidden">{languages[code]}</span>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="palette-open" data-palette-open aria-keyshortcuts="Meta+K Control+K">
        <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M11.5 11.5 16 16" stroke="currentColor" stroke-width="1.8" />
        </svg>
        <span class="palette-label">{palette[lang].open}</span>
        <kbd class="palette-kbd" data-kbd>Ctrl K</kbd>
      </button>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  // En Mac el atajo se escribe ⌘K; en el resto, Ctrl K
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll("[data-kbd]").forEach((k) => (k.textContent = "⌘K"));
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "brand tools"
      "nav nav";
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding-block: var(--space-1);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .brand {
      font-size: var(--step-0);
    }
  }

  .brand :global(.logo-core) {
    transform-origin: 16px 19px;
    transition: transform var(--slow) var(--ease-out);
  }

  .brand:hover :global(.logo-core) {
    transform: scale(1.35);
  }

  .nav {
    grid-area: nav;
  }

  .nav ul,
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    padding: 0;
    list-style: none;
  }

  .nav ul {
    gap: 0 0.9rem;
  }

  .nav a {
    display: inline-block;
    padding-block: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    text-decoration: none;
  }

  /* Estoy en esa página: subrayado de rotulador, como el idioma activo */
  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .langs {
    gap: 0;
  }

  /* En móvil el tema se queda solo con el icono */
  @media (max-width: 30rem) {
    .tools :global([data-theme-label]) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .langs a {
      min-width: 36px;
    }
  }

  .langs a {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
  }

  .langs a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 56rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "brand nav tools";
    }

    .nav ul {
      justify-content: center;
      gap: var(--space-3);
    }
  }

  /* Abre la paleta de comandos (#34); en móvil solo queda la lupa */
  .palette-open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }

  .palette-open:hover {
    border-color: var(--ink);
  }

  .palette-kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--ink-soft);
  }

  @media (max-width: 40rem) {
    /* El texto se oculta a la vista, no al lector de pantalla */
    .palette-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .palette-kbd {
      display: none;
    }

    .palette-open {
      justify-content: center;
      padding: 0;
    }
  }
</style>

