---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import NewTab from "./NewTab.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot">
    <p class="sign">
      <Logo size={22} />
      <span>Marc Calatayud · {year}</span>
    </p>
    <p class="made">{t("footer.made")}</p>
    <p class="meta label">
      <span>{t("footer.notebook")}</span>
      <a href="https://github.com/marcalvear/mi-web" target="_blank" rel="noopener">{t("footer.code")} <span aria-hidden="true">↗</span><NewTab /></a>
      <a href={getRelativeLocaleUrl(lang, "mi-espacio/")}>{t("footer.space")}</a>
      <a href={getRelativeLocaleUrl(lang, "privacidad/")}>{t("footer.privacy")}</a>
    </p>
    <p class="top label"><a href="#main">{t("footer.top")} ↑</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-7);
    border-top: 1px solid var(--rule);
    background: var(--sheet);
  }

  .foot {
    display: grid;
    gap: var(--space-1);
    /* Abajo deja sitio para el botón fijo del chat, que si no tapa la
       última fila de enlaces (#77) */
    padding-block: var(--space-4) var(--space-7);
  }

  .sign {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .made {
    color: var(--ink-soft);
    font-style: italic;
  }

  /* Centrados: los enlaces llevan relleno para el dedo y el texto de
     «Cuaderno nº 3» no, así que con la alineación por defecto quedaba más
     arriba que ellos */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  .meta a,
  .top a {
    display: inline-block;
    padding-block: 0.6rem;
  }

  /* «Volver arriba» va aparte, más abajo, para no confundirlo con los
     enlaces del resto de la web */
  .top {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-2);
    border-top: 1px dashed var(--rule);
  }
</style>
