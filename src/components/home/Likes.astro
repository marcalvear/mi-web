---
// Me gusta: tres «muestras» del cuaderno. Cada tarjeta lleva a su página
// (#71): videojuegos, anime y manga, y biohacking.
import Entry from "../Entry.astro";
import HobbyCards from "../likes/HobbyCards.astro";
import type { HomeContent } from "../../i18n/home";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  content: HomeContent["likes"];
}
const { lang, content } = Astro.props;
---

<Entry id="me-gusta" number={3} kicker={content.kicker} title={content.title}>
  <p class="intro">{content.intro}</p>
  <HobbyCards lang={lang} groups={content.groups} open={content.open} />
</Entry>

<style>
  .intro {
    font-size: var(--step-1);
  }
</style>
