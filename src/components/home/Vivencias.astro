---
// Mis vivencias: fotos personales en tres subapartados (deportes, viajes y
// conciertos), pegadas como un collage. Van entre la bitácora de «Lo que he
// hecho» y «Me gusta». Las fotos ya están en WebP y sin metadatos.
// Al pulsar una foto se abre en el visor (Visor.astro).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Entry from "../Entry.astro";
import Ampliable from "../Ampliable.astro";
import type { HomeContent } from "../../i18n/home";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  content: HomeContent["vivencias"];
}
const { lang, content } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>("../../assets/img/vivencias/*.webp", {
  eager: true,
});
const foto = (nombre: string) => fotos[`../../assets/img/vivencias/${nombre}.webp`].default;
---

<Entry id="vivencias" number={3} kicker={content.kicker} title={content.title}>
  {
    content.groups.map((grupo, gi) => (
      <section class="grupo" aria-labelledby={`vivencias-${gi}`}>
        <h3 id={`vivencias-${gi}`}>{grupo.title}</h3>
        <ul class="collage" role="list">
          {grupo.photos.map((p, i) => {
            const img = foto(p.image);
            return (
              <li class="snap" style={`--tilt: ${i % 2 ? 0.9 : -1.2}deg`}>
                <figure>
                  <Ampliable src={img} alt={p.alt} caption={p.caption} lang={lang}>
                    <Picture
                      src={img}
                      alt={p.alt}
                      formats={["avif", "webp"]}
                      widths={[400, 800]}
                      sizes="(min-width: 64rem) 20rem, (min-width: 48rem) 30vw, 45vw"
                      loading="lazy"
                    />
                  </Ampliable>
                  <figcaption>{p.caption}</figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</Entry>

<style>
  .grupo + .grupo {
    margin-block-start: var(--space-5);
  }

  h3 {
    margin-block-end: var(--space-3);
    font-size: var(--step-1);
  }

  /* Dos columnas en el móvil y tres grandes a partir de la tableta */
  .collage {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .collage {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5) var(--space-4);
    }
  }

  /* Cada foto, pegada en una ficha con un giro leve, como en la libreta */
  .snap {
    position: relative;
    padding: var(--space-1);
    background: var(--sheet);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 0 var(--rule), 0 10px 24px -18px rgb(0 0 0 / 0.4);
    rotate: var(--tilt);
    transition:
      rotate var(--mid) var(--ease-out),
      translate var(--mid) var(--ease-out),
      scale var(--mid) var(--ease-out),
      box-shadow var(--mid) var(--ease-out);
  }

  .snap::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset-block-start: -10px;
    inset-inline-start: 50%;
    width: 72px;
    height: 20px;
    translate: -50% 0;
    rotate: 2deg;
    background: color-mix(in srgb, var(--mark) 65%, transparent);
    pointer-events: none;
  }

  /* Al pasar el ratón la ficha se endereza, se levanta y crece un poco.
     Con teclado, igual al enfocar la foto */
  @media (hover: hover) and (pointer: fine) {
    .snap:hover {
      z-index: 2;
      rotate: 0deg;
      translate: 0 -6px;
      scale: 1.04;
      box-shadow: 0 1px 0 var(--rule), 0 22px 40px -22px rgb(0 0 0 / 0.55);
    }
  }

  .snap:has(:focus-visible) {
    z-index: 2;
    rotate: 0deg;
    translate: 0 -6px;
  }

  figure {
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }

  .snap :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  figcaption {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }

</style>
