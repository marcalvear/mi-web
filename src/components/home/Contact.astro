---
// Contacto: un clic y apareces. Debajo va el formulario conectado a n8n
// (ContactForm), que llega por el slot.
import Entry from "../Entry.astro";
import NewTab from "../NewTab.astro";
import type { HomeContent } from "../../i18n/home";

interface Props {
  content: HomeContent["contact"];
}
const { content } = Astro.props;
---

<Entry id="contacto" number={5} kicker={content.kicker} title={content.title}>
  <div class="contact">
    <div class="info">
      <p class="lead">{content.lead}</p>
      <ul class="channels" role="list">
        {
          content.channels.map((c) => (
            <li>
              <a href={c.href} target="_blank" rel="me noopener">
                <span class="name">{c.name}</span>
                <span class="label handle">{c.handle}</span>
                <svg class="arrow" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2 18 17 3M6 2.5h11.5V14" fill="none" stroke="currentColor" stroke-width="1.8" />
                </svg>
                <NewTab />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="form">
      <slot />
    </div>
  </div>
</Entry>

<style>
  .contact {
    display: grid;
    gap: var(--space-4) var(--space-5);
  }

  .lead {
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .channels {
    margin-block-start: var(--space-4);
    padding: 0;
    border-top: 1.5px solid var(--ink);
  }

  .channels li {
    max-width: none;
    border-bottom: 1px dashed var(--rule);
  }

  .channels a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name arrow"
      "handle arrow";
    align-items: center;
    column-gap: var(--space-2);
    padding-block: var(--space-2);
    color: var(--ink);
    text-decoration: none;
  }

  .name {
    grid-area: name;
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.1;
  }

  .handle {
    grid-area: handle;
  }

  .arrow {
    grid-area: arrow;
    transition: transform var(--fast) var(--ease-out);
  }

  .channels a:hover .name {
    font-style: italic;
    color: var(--accent);
  }

  /* La flecha sale en diagonal: estos enlaces llevan fuera de la web */
  /* Solo con ratón: en el móvil se quedaba puesto tras tocar (#79) */
  @media (hover: hover) and (pointer: fine) {
    .channels a:hover .arrow {
      transform: translate(4px, -4px);
      color: var(--accent);
    }
  }

  /* Canales a la izquierda y formulario a la derecha: sin medio ancho vacío */
  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (min-width: 48rem) {
    .channels a {
      grid-template-columns: 14rem 1fr auto;
      grid-template-areas: "name handle arrow";
    }
  }
</style>
