---
// Paleta de comandos (#34): ⌘K o Ctrl+K abre un buscador de secciones y
// acciones (tema, idioma, chat…). Es un <dialog> modal: el navegador atrapa
// el foco dentro y Esc lo cierra. La lista sigue el patrón combobox + listbox
// de ARIA: el foco se queda en el campo y aria-activedescendant dice cuál es
// la opción elegida.
import { getRelativeLocaleUrl } from "astro:i18n";
import { palette } from "../i18n/palette";
import { otherLang, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** Ruta de la página actual sin idioma, para la acción de cambiar de idioma */
  path: string;
}
const { lang, path } = Astro.props;
const t = palette[lang];
const c = t.commands;
const url = (p = "") => getRelativeLocaleUrl(lang, p);
const home = url();

type Command = { id: keyof typeof c; group: keyof typeof t.groups; href?: string; action?: string; external?: boolean };
const commands: Command[] = [
  { id: "home", group: "go", href: home },
  { id: "about", group: "go", href: `${home}#sobre-mi` },
  { id: "work", group: "go", href: `${home}#hecho` },
  { id: "case", group: "go", href: url("proyectos/sonrisa-imperial/") },
  { id: "likes", group: "go", href: url("me-gusta/") },
  { id: "games", group: "go", href: url("me-gusta/videojuegos/") },
  { id: "pokedex", group: "go", href: `${url("me-gusta/videojuegos/")}#pokedex` },
  { id: "anime", group: "go", href: url("me-gusta/anime-manga/") },
  { id: "quotes", group: "go", href: `${url("me-gusta/anime-manga/")}#frases` },
  { id: "compendio", group: "go", href: url("biohacking/") },
  { id: "bio", group: "go", href: url("me-gusta/biohacking/") },
  { id: "contact", group: "go", href: `${home}#formulario` },
  { id: "signIn", group: "go", href: url("entrar/") },
  { id: "space", group: "go", href: url("mi-espacio/") },
  { id: "panel", group: "go", href: url("panel/") },
  { id: "privacy", group: "go", href: url("privacidad/") },
  { id: "light", group: "actions", action: "theme:light" },
  { id: "dark", group: "actions", action: "theme:dark" },
  { id: "auto", group: "actions", action: "theme:auto" },
  { id: "lang", group: "actions", href: getRelativeLocaleUrl(otherLang(lang), path) },
  ...(import.meta.env.PUBLIC_CHATBOT_URL ? [{ id: "chat", group: "actions", action: "chat" } as Command] : []),
  { id: "copy", group: "actions", action: "copy" },
  { id: "code", group: "links", href: "https://github.com/marcalvear/mi-web", external: true },
  { id: "linkedin", group: "links", href: "https://www.linkedin.com/in/marccalatayud", external: true },
];
const data = commands.map((cmd) => ({ ...cmd, ...c[cmd.id] }));
const text = { groups: t.groups, empty: t.empty, copied: t.copied };
---

<dialog class="palette" aria-labelledby="palette-title" data-palette data-commands={JSON.stringify(data)} data-text={JSON.stringify(text)}>
  <h2 class="visually-hidden" id="palette-title">{t.title}</h2>
  <div class="search">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <circle cx="7.5" cy="7.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M11.5 11.5 16 16" stroke="currentColor" stroke-width="1.6" />
    </svg>
    <input
      type="text"
      role="combobox"
      aria-label={t.input}
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder={t.placeholder}
      data-query
    />
  </div>
  <ul id="palette-list" class="list" role="listbox" aria-label={t.title} data-list></ul>
  <p class="empty" role="status" data-empty></p>
  <p class="hint label" aria-hidden="true">{t.hint}</p>
</dialog>

<script>
  type Command = {
    id: string;
    group: string;
    label: string;
    keywords: string;
    href?: string;
    action?: string;
    external?: boolean;
  };
  type Text = { groups: Record<string, string>; empty: string; copied: string };

  const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
  if (dialog) init(dialog);

  // Sin mayúsculas ni tildes: «pokedex» encuentra «Pokédex»
  const fold = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  function init(dialog: HTMLDialogElement) {
    const commands = JSON.parse(dialog.dataset.commands!) as Command[];
    const t = JSON.parse(dialog.dataset.text!) as Text;
    const input = dialog.querySelector<HTMLInputElement>("[data-query]")!;
    const list = dialog.querySelector<HTMLUListElement>("[data-list]")!;
    const empty = dialog.querySelector<HTMLElement>("[data-empty]")!;
    let shown: Command[] = [];
    let active = 0;
    let opener: HTMLElement | null = null;

    // Primero lo que empieza por lo escrito, luego lo que lo contiene en el
    // título y por último lo que solo aparece en las palabras clave
    function search(q: string): Command[] {
      const query = fold(q.trim());
      if (!query) return commands;
      return commands
        .map((cmd, i) => {
          const label = fold(cmd.label);
          const score = label.startsWith(query)
            ? 0
            : label.split(/\s+/).some((w) => w.startsWith(query))
              ? 1
              : label.includes(query)
                ? 2
                : fold(cmd.keywords).includes(query)
                  ? 3
                  : -1;
          return { cmd, score, i };
        })
        .filter((r) => r.score >= 0)
        .sort((a, b) => a.score - b.score || a.i - b.i)
        .map((r) => r.cmd);
    }

    function render() {
      shown = search(input.value);
      active = Math.min(active, Math.max(shown.length - 1, 0));
      const items: HTMLElement[] = [];
      let group = "";
      const grouped = !input.value.trim(); // al buscar, solo importa el orden
      shown.forEach((cmd, i) => {
        if (grouped && cmd.group !== group) {
          group = cmd.group;
          const title = document.createElement("li");
          title.className = "group label";
          title.setAttribute("role", "presentation");
          title.textContent = t.groups[group];
          items.push(title);
        }
        const li = document.createElement("li");
        li.id = `palette-${cmd.id}`;
        li.className = "option";
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", String(i === active));
        li.textContent = cmd.label;
        if (cmd.external) li.append(Object.assign(document.createElement("span"), { className: "ext", textContent: "↗" }));
        li.addEventListener("mousemove", () => select(i));
        li.addEventListener("click", () => run(cmd));
        items.push(li);
      });
      list.replaceChildren(...items);
      empty.textContent = shown.length ? "" : t.empty.replace("{q}", input.value.trim());
      updateActive();
    }

    function select(i: number) {
      if (i === active) return;
      active = i;
      list.querySelectorAll('[role="option"]').forEach((el, j) => el.setAttribute("aria-selected", String(j === active)));
      updateActive();
    }

    function updateActive() {
      const option = shown[active] ? document.getElementById(`palette-${shown[active].id}`) : null;
      if (option) {
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    }

    function open() {
      if (dialog.open) return;
      opener = document.activeElement as HTMLElement | null;
      input.value = "";
      active = 0;
      render();
      dialog.showModal();
      input.focus();
    }

    function close() {
      dialog.close();
    }

    async function run(cmd: Command) {
      // El chat se queda con el foco; en lo demás vuelve a donde estaba
      if (cmd.action === "chat") opener = null;
      close();
      if (cmd.href) {
        if (cmd.external) window.open(cmd.href, "_blank", "noopener");
        else location.assign(cmd.href);
        return;
      }
      if (cmd.action?.startsWith("theme:")) {
        // ThemeToggle escucha este evento: así el botón de la cabecera se entera
        document.dispatchEvent(new CustomEvent("theme:set", { detail: cmd.action.slice(6) }));
      } else if (cmd.action === "chat") {
        const launcher = document.querySelector<HTMLButtonElement>("[data-launcher]");
        if (launcher?.getAttribute("aria-expanded") !== "true") launcher?.click();
      } else if (cmd.action === "copy") {
        try {
          await navigator.clipboard.writeText(location.href);
          toast(t.copied);
        } catch {
          /* sin permiso para el portapapeles no se copia nada */
        }
      }
    }

    // Un aviso breve para las acciones que no cambian de página
    function toast(message: string) {
      const note = document.createElement("p");
      note.className = "palette-toast";
      note.setAttribute("role", "status");
      note.textContent = message;
      document.body.append(note);
      setTimeout(() => note.remove(), 2200);
    }

    input.addEventListener("input", () => {
      active = 0;
      render();
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        if (!shown.length) return;
        select((active + (e.key === "ArrowDown" ? 1 : -1) + shown.length) % shown.length);
      } else if (e.key === "Home" || e.key === "End") {
        if (!shown.length) return;
        e.preventDefault();
        select(e.key === "Home" ? 0 : shown.length - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (shown[active]) run(shown[active]);
      }
    });

    // Al cerrar, el foco vuelve a donde estaba
    dialog.addEventListener("close", () => opener?.focus());
    // Clic fuera de la ficha (en el fondo del diálogo) también cierra
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      }
    });
    document.querySelectorAll<HTMLElement>("[data-palette-open]").forEach((b) => b.addEventListener("click", open));
  }
</script>

<style>
  /* Una ficha del cuaderno que cae sobre la página */
  .palette {
    width: min(36rem, calc(100vw - 2 * var(--space-2)));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--rule);
  }

  .palette[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
  }

  .palette::backdrop {
    background: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .search {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    border-bottom: 1.5px solid var(--ink);
    color: var(--ink-soft);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    outline: none;
  }

  .list {
    margin: 0;
    padding: var(--space-1) 0;
    overflow-y: auto;
    list-style: none;
  }

  .list :global(.group) {
    padding: var(--space-1) var(--space-2) 0.2rem;
    color: var(--ink-soft);
  }

  .list :global(.option) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    min-height: 44px;
    align-items: center;
    padding: 0.4rem var(--space-2);
    cursor: pointer;
  }

  /* La opción elegida, subrayada con el rotulador rojo en el margen */
  .list :global(.option[aria-selected="true"]) {
    background: var(--paper);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .list :global(.ext) {
    color: var(--ink-soft);
  }

  .empty {
    padding: 0 var(--space-2) var(--space-2);
    color: var(--ink-soft);
    font-style: italic;
  }

  .empty:empty {
    display: none;
  }

  .hint {
    padding: var(--space-1) var(--space-2);
    border-top: 1px dashed var(--rule);
    color: var(--ink-soft);
  }

  :global(.palette-toast) {
    position: fixed;
    left: 50%;
    bottom: var(--space-4);
    z-index: 60;
    translate: -50% 0;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--ink);
    background: var(--sheet);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    box-shadow: 3px 3px 0 var(--rule);
  }
</style>
