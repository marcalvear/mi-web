---
// Página de privacidad (RGPD) del formulario de contacto (#30). Texto corto y
// claro: qué datos, para qué, dónde, cuánto tiempo y cómo borrarlos.
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import { contact } from "../../i18n/contact";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = contact[lang].privacy;
const form = `${getRelativeLocaleUrl(lang)}#formulario`;
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="privacidad/">
  <div class="wrap">
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <p class="label updated">{c.updated}</p>
    </header>

    <ol class="sections" role="list">
      {
        c.sections.map((s, i) => (
          <li>
            <h2>
              <span class="label num">§{i + 1}</span> {s.title}
            </h2>
            {s.body.map((p) => (
              <p>{p}</p>
            ))}
          </li>
        ))
      }
    </ol>

    <p class="back"><a href={form}>← {c.back}</a></p>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-4);
  }

  .lead {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .updated {
    color: var(--ink-soft);
  }

  .sections {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    padding: 0;
  }

  .sections li {
    display: grid;
    gap: var(--space-1);
    padding-block-start: var(--space-3);
    border-top: 1px dashed var(--rule);
  }

  h2 {
    font-size: var(--step-2);
  }

  .num {
    margin-inline-end: 0.4em;
    color: var(--accent);
  }

  .back {
    margin-block: var(--space-5) var(--space-7);
  }
</style>
