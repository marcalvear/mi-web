---
// Esquema de la temporada de resfriados para el problema de las defensas: los
// doce meses, la curva del sol (con la que la piel fabrica vitamina D), la
// temporada de octubre a marzo y, abajo, lo que se toma al primer síntoma.
// Dibujado a mano alzada como el resto de esquemas del compendio.
import rough from "roughjs";
import type { CompendioText } from "../../i18n/compendio";
import SketchMap, { type MapMarker, type SketchGroup } from "./SketchMap.astro";

interface Props {
  markers: MapMarker[];
  text: CompendioText["season"];
  thumb?: boolean;
}
const { markers, text, thumb = false } = Astro.props;

const X0 = 30;
const W = 340 / 12;
const mx = (m: number) => Math.round(X0 + m * W);
const AXIS = 214;

const gen = rough.generator();
const toPath = (set: Parameters<typeof gen.opsToPath>[0]) =>
  gen.opsToPath(set).replace(/-?\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));
const base = { roughness: 1.1, bowing: 1, stroke: "currentColor", strokeWidth: 1.6 };
function draw(d: string, seed: number, fill = true) {
  const outline: string[] = [];
  const fills: string[] = [];
  const opts = fill ? { fill: "currentColor", fillStyle: "hachure", hachureGap: 7, fillWeight: 0.6, hachureAngle: -41 + seed * 7 } : {};
  for (const set of gen.path(d, { ...base, ...opts, seed }).sets) {
    if (set.type === "fillSketch") fills.push(toPath(set));
    else if (set.type === "path") outline.push(toPath(set));
  }
  return { outline, fills };
}
const line = (d: string, seed: number, strokeWidth = 1.2) => toPath(gen.path(d, { ...base, strokeWidth, seed }).sets[0]);
const rect = (x0: number, x1: number, y0: number, y1: number) => `M${x0} ${y0} L${x1} ${y0} L${x1} ${y1} L${x0} ${y1} Z`;

// La temporada va de octubre a marzo: dos trozos, uno a cada lado del año
const winterA = draw(rect(mx(0), mx(3), 124, 204), 20);
const winterB = draw(rect(mx(9), mx(12), 124, 204), 21);
const firstSign = draw(rect(mx(0), mx(12), 236, 268), 22);
// El sol: alto en verano y bajo en invierno
const sun = line(`M${mx(0)} 112 C${mx(3)} 100 ${mx(4.5)} 54 ${mx(6)} 50 C${mx(7.5)} 54 ${mx(9)} 100 ${mx(12)} 112`, 3, 2.2);
const axis = [
  line(`M${X0 - 8} ${AXIS} L${mx(12) + 8} ${AXIS}`, 4),
  ...Array.from({ length: 13 }, (_, i) => line(`M${mx(i)} ${AXIS - 4} L${mx(i)} ${AXIS + 4}`, 10 + i)),
];
// Un sol pequeño en lo alto de la curva y un pañuelo en la barra de abajo
const sx = mx(6);
const sunIcon = draw(`M${sx - 8} 30 A8 8 0 1 1 ${sx + 8} 30 A8 8 0 1 1 ${sx - 8} 30 Z`, 6);
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * 2 * Math.PI;
  const p = (r: number) => `${Math.round((sx + r * Math.cos(a)) * 10) / 10} ${Math.round((30 + r * Math.sin(a)) * 10) / 10}`;
  return line(`M${p(12)} L${p(17)}`, 60 + i);
});

const groups: SketchGroup[] = [
  { zone: "temporada", outline: [...winterA.outline, ...winterB.outline], hachure: [...winterA.fills, ...winterB.fills], details: [] },
  { zone: "sintoma", outline: firstSign.outline, hachure: firstSign.fills, details: [] },
  { outline: sunIcon.outline, hachure: sunIcon.fills, details: [sun, ...rays, ...axis] },
];

// En la temporada, uno debajo de otro en octubre-diciembre; abajo, en fila
const byZone: Record<string, number> = {};
const placed = markers.map((m) => {
  const k = byZone[m.zone] ?? 0;
  byZone[m.zone] = k + 1;
  const total = markers.filter((x) => x.zone === m.zone).length;
  if (m.zone === "sintoma") return { ...m, x: 200 + (k - (total - 1) / 2) * 60, y: 252 };
  const step = total > 1 ? Math.min(28, 64 / (total - 1)) : 0;
  return { ...m, x: (mx(9) + mx(12)) / 2, y: 164 - ((total - 1) * step) / 2 + k * step };
});
const months = text.months;
---

<SketchMap viewBox="0 0 400 290" idPrefix="temporada" groups={groups} placed={placed} markers={markers} text={text} thumb={thumb}>
  <g class="names" font-size="10">
    {
      months.map((m, i) => (
        <text x={(mx(i) + mx(i + 1)) / 2} y={AXIS + 15} text-anchor="middle">
          {m}
        </text>
      ))
    }
    <text x={mx(6) + 28} y="34">{text.sun}</text>
    <text x={(mx(0) + mx(3)) / 2} y="118" text-anchor="middle">{text.zones.temporada}</text>
    <text x={(mx(9) + mx(12)) / 2} y="118" text-anchor="middle">{text.zones.temporada}</text>
    <text x="200" y="284" text-anchor="middle">{text.zones.sintoma}</text>
  </g>
</SketchMap>
