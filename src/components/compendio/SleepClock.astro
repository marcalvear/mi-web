---
// Reloj de 24 horas para el problema «dormir mejor» (#83): cada suplemento se
// toma en un momento distinto de la noche y el reloj lo marca, dibujado a mano
// alzada como el esquema digestivo. Las medianoches arriba y el día gira en el
// sentido de las agujas. Las horas suponen que te acuestas a las 23:00.
import rough from "roughjs";
import type { CompendioText } from "../../i18n/compendio";
import SketchMap, { type MapMarker, type SketchGroup } from "./SketchMap.astro";

interface Props {
  markers: MapMarker[];
  text: CompendioText["clock"];
}
const { markers, text } = Astro.props;

const C = 200;
const CY = 205;
const at = (h: number, r: number): [number, number] => {
  const a = (h / 24) * 2 * Math.PI - Math.PI / 2;
  return [Math.round((C + r * Math.cos(a)) * 10) / 10, Math.round((CY + r * Math.sin(a)) * 10) / 10];
};
// Sector del anillo entre dos horas y dos radios
const sector = (h0: number, h1: number, r0: number, r1: number) => {
  const span = (h1 - h0 + 24) % 24;
  const big = span > 12 ? 1 : 0;
  const [a, b] = [at(h0, r1), at(h1, r1)];
  const [c, d] = [at(h1, r0), at(h0, r0)];
  return `M${a} A${r1} ${r1} 0 ${big} 1 ${b} L${c} A${r0} ${r0} 0 ${big} 0 ${d} Z`;
};

// Momentos de la noche: cada ficha dice el suyo en «zona»
const zones: Record<string, [number, number]> = {
  previa: [20, 21],
  cena: [21, 22],
  acostarse: [22, 23],
};
const R0 = 96;
const R1 = 148;

const gen = rough.generator();
const toPath = (set: Parameters<typeof gen.opsToPath>[0]) =>
  gen.opsToPath(set).replace(/-?\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));
const base = { roughness: 1.1, bowing: 1, stroke: "currentColor", strokeWidth: 1.6 };
const hachure = { fill: "currentColor", fillStyle: "hachure", hachureGap: 6, fillWeight: 0.7 };
function draw(d: string, seed: number, fill = true) {
  const outline: string[] = [];
  const fills: string[] = [];
  for (const set of gen.path(d, { ...base, ...(fill ? { ...hachure, hachureAngle: -41 + seed * 9 } : {}), seed }).sets) {
    if (set.type === "fillSketch") fills.push(toPath(set));
    else if (set.type === "path") outline.push(toPath(set));
  }
  return { outline, fills };
}
const line = (d: string, seed: number) => toPath(gen.path(d, { ...base, strokeWidth: 1.1, seed }).sets[0]);

// Esfera, marcas de las horas, la luna arriba a la derecha y el sol abajo
const dial = draw(`M${C - 170} ${CY} A170 170 0 1 1 ${C + 170} ${CY} A170 170 0 1 1 ${C - 170} ${CY} Z`, 3, false);
const ticks = Array.from({ length: 24 }, (_, h) => {
  const [x0, y0] = at(h, h % 6 === 0 ? 150 : 160);
  const [x1, y1] = at(h, 170);
  return line(`M${x0} ${y0} L${x1} ${y1}`, 40 + h);
});
const [mx, my] = at(2.6, 122);
const moon = draw(
  `M${mx + 6} ${my - 14} A15 15 0 1 0 ${mx + 6} ${my + 14} A11 11 0 1 1 ${mx + 6} ${my - 14} Z`,
  7,
);
const [sx, sy] = at(13, 122);
const sun = draw(`M${sx - 10} ${sy} A10 10 0 1 1 ${sx + 10} ${sy} A10 10 0 1 1 ${sx - 10} ${sy} Z`, 9);
const rays = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * 2 * Math.PI;
  const p = (r: number) => `${Math.round((sx + r * Math.cos(a)) * 10) / 10} ${Math.round((sy + r * Math.sin(a)) * 10) / 10}`;
  return line(`M${p(15)} L${p(21)}`, 60 + i);
});
// Las horas de sueño, en un anillo por dentro
const sleep = draw(sector(23, 7, 58, 86), 5);

const groups: SketchGroup[] = [
  { outline: dial.outline, hachure: [], details: ticks },
  { outline: [...moon.outline, ...sun.outline], hachure: [...moon.fills, ...sun.fills], details: rays },
  { outline: sleep.outline, hachure: sleep.fills, details: [] },
  ...Object.entries(zones).map(([zone, [h0, h1]], i) => {
    const z = draw(sector(h0, h1, R0, R1), 20 + i);
    return { zone, outline: z.outline, hachure: z.fills, details: [] };
  }),
];

// Marcadores en el centro de su momento; si hay varios, se apilan hacia fuera
const byZone: Record<string, number> = {};
const placed = markers.map((m) => {
  const k = byZone[m.zone] ?? 0;
  byZone[m.zone] = k + 1;
  const [h0, h1] = zones[m.zone] ?? [0, 1];
  const total = markers.filter((x) => x.zone === m.zone).length;
  const r = total === 1 ? (R0 + R1) / 2 : R0 + 14 + (k * (R1 - R0 - 28)) / (total - 1);
  const [x, y] = at((h0 + h1) / 2, r);
  return { ...m, x, y };
});
const hours = [0, 3, 6, 9, 12, 15, 18, 21].map((h) => ({ h, xy: at(h, 186) }));
// «Dormir», en el hueco de dentro, junto a su anillo
const [lx, ly] = at(3, 38);
---

<SketchMap viewBox="0 0 400 412" idPrefix="reloj" groups={groups} placed={placed} markers={markers} text={text}>
  <g class="names" font-size="11">
    {
      hours.map(({ h, xy }) => (
        <text x={xy[0]} y={xy[1] + 4} text-anchor="middle" font-weight={h % 6 === 0 ? 700 : 400}>
          {String(h).padStart(2, "0")}
        </text>
      ))
    }
    <text x={lx} y={ly} text-anchor="middle">{text.sleep}</text>
  </g>
</SketchMap>
