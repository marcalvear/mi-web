---
// Estrés oxidativo para «Envejecer mejor»: una mitocondria, la central de
// energía de la célula, suelta radicales libres (un círculo con un solo punto:
// el electrón que les falta) que van hacia la vista, la piel y el hueso. Cada
// suplemento se coloca donde actúa: la NAC y la vitamina C, en las defensas
// de la propia célula; los demás, en lo que protegen.
import rough from "roughjs";
import type { CompendioText } from "../../i18n/compendio";
import SketchMap, { type MapMarker, type SketchGroup } from "./SketchMap.astro";

interface Props {
  markers: MapMarker[];
  text: CompendioText["oxidation"];
  thumb?: boolean;
}
const { markers, text, thumb = false } = Astro.props;

const gen = rough.generator();
const toPath = (set: Parameters<typeof gen.opsToPath>[0]) =>
  gen.opsToPath(set).replace(/-?\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));
const base = { roughness: 1.1, bowing: 1, stroke: "currentColor", strokeWidth: 1.6 };
function draw(d: string, seed: number, fill = true, roughness = base.roughness) {
  const outline: string[] = [];
  const fills: string[] = [];
  const opts = fill ? { fill: "currentColor", fillStyle: "hachure", hachureGap: 6.5, fillWeight: 0.6, hachureAngle: -41 + seed * 7 } : {};
  for (const set of gen.path(d, { ...base, ...opts, roughness, seed }).sets) {
    if (set.type === "fillSketch") fills.push(toPath(set));
    else if (set.type === "path") outline.push(toPath(set));
  }
  return { outline, fills };
}
const line = (d: string, seed: number, roughness?: number) => draw(d, seed, false, roughness).outline;
const circle = (x: number, y: number, r: number) =>
  `M${x - r} ${y} C${x - r} ${y - r * 0.55} ${x - r * 0.55} ${y - r} ${x} ${y - r} C${x + r * 0.55} ${y - r} ${x + r} ${y - r * 0.55} ${x + r} ${y} C${x + r} ${y + r * 0.55} ${x + r * 0.55} ${y + r} ${x} ${y + r} C${x - r * 0.55} ${y + r} ${x - r} ${y + r * 0.55} ${x - r} ${y} Z`;

// La mitocondria: una judía con doble membrana y las crestas dentro, en zigzag
const mito = draw("M30 130 C30 92 70 78 110 80 C150 82 182 100 182 130 C182 160 150 178 110 180 C70 182 30 168 30 130 Z", 3);
const inner = line("M40 130 C40 98 74 88 110 90 C146 92 172 106 172 130 C172 154 146 168 110 170 C74 172 40 162 40 130 Z", 4, 0.8);
const crests = line(
  "M46 130 C54 102 62 102 68 130 C74 158 82 158 88 130 C94 102 102 102 108 130 C114 158 122 158 128 130 C134 102 142 102 148 130 C154 158 160 152 166 132",
  5,
);

// Los radicales libres salen de la mitocondria hacia lo que dañan
const arrows = [
  line("M186 116 C214 90 246 70 276 62 M266 54 L278 62 L266 70", 8),
  line("M188 132 C218 130 248 134 276 136 M265 129 L277 136 L265 143", 9),
  line("M186 148 C214 172 246 196 276 206 M264 199 L277 207 L263 213", 10),
];
const radicals: [number, number][] = [
  [218, 88],
  [234, 133],
  [222, 176],
];
const radicalRings = radicals.map(([x, y], i) => line(circle(x, y, 7), 30 + i, 0.4));

// Lo que protegen: el ojo, la piel (tres capas) y el hueso
const eye = draw("M282 58 C300 34 344 34 362 58 C344 82 300 82 282 58 Z", 12, false);
const iris = draw(circle(322, 58, 13), 13);
const skin = draw("M282 114 C302 108 322 120 342 114 C350 111 356 112 362 114 L362 158 L282 158 Z", 14);
const skinLayers = [
  ...line("M286 130 C306 124 326 136 346 130 C352 128 356 128 360 130", 15),
  ...line("M286 144 C306 138 326 150 346 144 C352 142 356 142 360 144", 16),
];
const bone = draw(
  "M292 202 C282 196 282 186 292 186 C300 186 302 194 304 198 L340 198 C342 194 344 186 352 186 C362 186 362 196 352 202 C362 208 362 218 352 218 C344 218 342 210 340 206 L304 206 C302 210 300 218 292 218 C282 218 282 208 292 202 Z",
  17,
);

const groups: SketchGroup[] = [
  { zone: "celula", outline: mito.outline, hachure: mito.fills, details: [...inner, ...crests] },
  { outline: arrows.flat(), hachure: [], details: radicalRings.flat() },
  { zone: "ojo", outline: [...eye.outline, ...iris.outline], hachure: iris.fills, details: [] },
  { zone: "piel", outline: skin.outline, hachure: skin.fills, details: skinLayers },
  { zone: "hueso", outline: bone.outline, hachure: bone.fills, details: [] },
];

// Los marcadores de las defensas de la célula van en fila dentro de la
// mitocondria; los demás, en columna a la derecha de lo que protegen
const anchors: Record<string, [number, number, "row" | "column"]> = {
  celula: [86, 130, "row"],
  ojo: [398, 58, "column"],
  piel: [398, 110, "column"],
  hueso: [398, 202, "column"],
};
const byZone: Record<string, number> = {};
const placed = markers.map((m) => {
  const k = byZone[m.zone] ?? 0;
  byZone[m.zone] = k + 1;
  const [x, y, dir] = anchors[m.zone] ?? [220, 240, "row"];
  return dir === "row" ? { ...m, x: x + k * 40, y } : { ...m, x, y: y + k * 26 };
});
---

<SketchMap viewBox="0 0 440 260" idPrefix="oxidacion" groups={groups} placed={placed} markers={markers} text={text} thumb={thumb}>
  {
    !thumb && (
      <g class="names" font-size="11">
        <g fill="currentColor" stroke="none">
          {radicals.map(([x, y]) => (
            <circle cx={x + 2} cy={y - 2} r="1.8" />
          ))}
        </g>
        <text x="106" y="204" text-anchor="middle">{text.mito}</text>
        <text x="200" y="26" text-anchor="middle">{text.radicals}</text>
        <text x="200" y="39" text-anchor="middle" class="small">{text.electron}</text>
        <line x1="208" y1="45" x2="216" y2="78" />
        <text x="322" y="96" text-anchor="middle">{text.zones.ojo}</text>
        <text x="322" y="176" text-anchor="middle">{text.zones.piel}</text>
        <text x="322" y="240" text-anchor="middle">{text.zones.hueso}</text>
      </g>
    )
  }
</SketchMap>

<style>
  .small {
    font-size: 9.5px;
    font-style: italic;
  }
</style>
