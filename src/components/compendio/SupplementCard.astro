---
// Ficha de un suplemento: lo esencial a la vista (qué es, evidencia, dosis) y la
// ciencia plegada debajo, con cada hallazgo enlazado a su estudio. Si hay
// productos, van al final con su foto y los datos de la web oficial.
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import type { CompendioText } from "../../i18n/compendio";
import EvidenceMeter from "./EvidenceMeter.astro";
import ProductList from "./ProductList.astro";
import FavStar from "./FavStar.astro";
import NewTab from "../NewTab.astro";

interface Props {
  entry: CollectionEntry<"suplementos">;
  n: number;
  lang: Lang;
  text: CompendioText;
  /** Si el problema tiene esquema, la ficha lleva el botón para verla en él */
  hasMap?: boolean;
  /** Zona del esquema en este problema, si el problema la cambia (campo «zonas») */
  zone?: string;
}
const { entry, n, lang, text, hasMap = false, zone } = Astro.props;
const s = entry.data;
const c = text.card;
const code = `S-${String(n).padStart(2, "0")}`;
// Número de cada fuente para citarla en los hallazgos: [1], [2]…
const refN = Object.fromEntries(s.fuentes.map((f, i) => [f.pmid, i + 1]));
const refId = (pmid: string) => `${entry.id}-ref-${pmid}`;
---

<li class="sheet" id={entry.id} data-sheet={entry.id} data-evidence={s.evidencia} data-zone={zone ?? s.zona}>
  <article aria-labelledby={`${entry.id}-name`}>
    <header class="head">
      <div class="top">
        <p class="label code"><span class="badge">{n}</span> {c.id} {code} · {s.tipo[lang]}</p>
        <FavStar id={entry.id} name={s.nombre[lang]} text={text.fav} />
      </div>
      <h3 id={`${entry.id}-name`}>{s.nombre[lang]}</h3>
      <EvidenceMeter level={s.evidencia} label={text.evidenceLabel} value={text.evidence[s.evidencia]} />
    </header>

    <p class="summary">{s.resumen[lang]}</p>

    <dl class="readout">
      <div>
        <dt class="label">{c.dose}</dt>
        <dd>{s.dosis[lang]}</dd>
      </div>
      <div>
        <dt class="label">{c.when}</dt>
        <dd>{s.cuando[lang]}</dd>
      </div>
    </dl>

    <details class="science">
      <summary>
        <span class="when-closed">{c.science}</span>
        <span class="when-open">{c.scienceClose}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </summary>
      <div class="science-body">
        <section>
          <h4 class="label">{c.how}</h4>
          <p>{s.mecanismo[lang]}</p>
        </section>
        <section>
          <h4 class="label">{c.found}</h4>
          <ul class="found" role="list">
            {
              s.hallazgos.map((h) => (
                <li>
                  {h.texto[lang]}{" "}
                  <a class="cite" href={`#${refId(h.fuente)}`}>[{refN[h.fuente]}]</a>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="why">
          <h4 class="label">{c.why}</h4>
          <p>{s.porQue[lang]}</p>
        </section>
        <section>
          <h4 class="label">{c.cautions}</h4>
          <ul class="cautions" role="list">
            {s.precauciones.map((p) => <li>{p[lang]}</li>)}
          </ul>
        </section>
        <section>
          <h4 class="label">{c.sources}</h4>
          <ol class="sources">
            {
              s.fuentes.map((f) => (
                <li id={refId(f.pmid)}>
                  {f.autores} ({f.anio}). <cite>{f.titulo}</cite>. {f.revista}.{" "}
                  <a href={`https://pubmed.ncbi.nlm.nih.gov/${f.pmid}/`} target="_blank" rel="noopener">
                    PubMed <span aria-hidden="true">↗</span><NewTab />
                  </a>
                  {f.doi && (
                    <>
                      {" · "}
                      <a href={`https://doi.org/${f.doi}`} target="_blank" rel="noopener">
                        DOI <span aria-hidden="true">↗</span><NewTab />
                      </a>
                    </>
                  )}
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </details>

    {
      s.productos && (
        <ProductList products={s.productos} lang={lang} text={c} id={`${entry.id}-products`} heading={c.products} />
      )
    }

    {
      hasMap && (
        <button type="button" class="to-map" data-to-map={entry.id}>
          <span aria-hidden="true">◎</span> {c.showOnMap}
        </button>
      )
    }
  </article>
</li>

<style>
  .sheet {
    position: relative;
    /* Es un li: sin esto se quedaría en el ancho de lectura y no en el de su columna */
    max-width: none;
    scroll-margin-top: var(--space-4);
  }

  .sheet[hidden] {
    display: none;
  }

  article {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    border-left: 4px solid var(--lab);
    box-shadow: 4px 4px 0 var(--rule);
    transition:
      box-shadow var(--fast) var(--ease-out),
      transform var(--fast) var(--ease-out);
  }

  /* La ficha activa se levanta un poco, como al cogerla del archivador */
  .sheet.on article {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--lab);
  }

  .head {
    display: grid;
    gap: var(--space-1);
  }

  /* Alto fijo: la estrella aparece al cargar y no mueve nada (CLS) */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    min-height: 44px;
  }


  .code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-soft);
  }

  .badge {
    display: inline-grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border: 1.5px solid var(--lab);
    border-radius: 50%;
    color: var(--lab);
    font-weight: 700;
  }

  h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .summary {
    max-width: 60ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .readout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1px;
    margin: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .readout div {
    display: grid;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
    background: var(--lab-soft);
  }

  .readout dt {
    color: var(--lab);
  }

  .readout dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .science {
    border-top: 1px dashed var(--rule);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    transition: transform var(--fast) var(--ease-out);
  }

  .science[open] summary svg {
    transform: rotate(180deg);
  }

  .when-open,
  .science[open] .when-closed {
    display: none;
  }

  .science[open] .when-open {
    display: inline;
  }

  .science-body {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-1) var(--space-2);
  }

  .science[open] .science-body {
    animation: unfold var(--mid) var(--ease-out);
  }

  @keyframes unfold {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  .science-body section {
    display: grid;
    gap: var(--space-1);
  }

  .science-body h4 {
    color: var(--lab);
  }

  .science-body p {
    max-width: 62ch;
  }

  .found,
  .cautions {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .found li,
  .cautions li {
    position: relative;
    max-width: 62ch;
    padding-inline-start: 1.4em;
  }

  .found li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--lab);
  }

  .cautions li::before {
    content: "!";
    position: absolute;
    left: 0.2em;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .cite {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .why p {
    padding: var(--space-1) var(--space-2);
    border-left: 2px solid var(--lab);
    background: var(--lab-soft);
  }

  .sources {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-inline-start: 1.6em;
    font-size: var(--step--1);
  }

  .sources li {
    scroll-margin-top: var(--space-5);
  }

  .sources li:target {
    background: var(--mark);
  }

  cite {
    font-style: italic;
  }

  .to-map {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    padding: 0 0.2rem;
    border: 0;
    background: none;
    color: var(--lab);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .to-map:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* En pantallas anchas el esquema ya está siempre a la vista */
  @media (min-width: 64rem) {
    .to-map {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    article {
      transition: none;
    }

    .science[open] .science-body {
      animation: none;
    }
  }
</style>
