---
// Productos que miraría, con su foto y los datos de la web oficial. Va dentro
// de cada ficha y, cuando un producto junta varios suplementos, al final del
// problema (#73).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import type { CompendioText } from "../../i18n/compendio";
import NewTab from "../NewTab.astro";
import FavStar from "./FavStar.astro";

type Product = NonNullable<CollectionEntry<"suplementos">["data"]["productos"]>[number];

interface Props {
  products: Product[];
  lang: Lang;
  text: CompendioText["card"];
  id: string;
  heading: string;
  /** h4 dentro de una ficha; h3 al final de un problema */
  level?: 3 | 4;
  /** Con los textos de la estrella, cada producto se puede guardar (#81) */
  fav?: CompendioText["fav"];
}
const { products, lang, text: c, id, heading, level = 4, fav } = Astro.props;
const Heading = level === 3 ? "h3" : "h4";
const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/img/compendio/*.webp", { eager: true });
const photo = (file: string) => photos[`../../assets/img/compendio/${file}`]?.default;
---

<section class:list={["products", { bundle: level === 3 }]} aria-labelledby={id}>
  <Heading class="label heading" id={id}>{heading}</Heading>
  <ul class="product-list" role="list">
    {
      products.map((p) => {
        const img = photo(p.foto);
        return (
          <li class="product" id={fav ? p.id : undefined}>
            <div class="photo">
              {img && (
                <Picture
                  src={img}
                  alt={p.alt[lang]}
                  formats={["avif", "webp"]}
                  widths={[240, 480, 720]}
                  sizes="(min-width: 30rem) 11rem, 8rem"
                  loading="lazy"
                />
              )}
            </div>
            <div class="top">
              <p class="label brand">
                {p.marca}
                {p.pais && <span class="origin"> · {p.pais[lang]}</span>}
              </p>
              {fav && <FavStar id={p.id} name={p.nombre} text={fav} />}
            </div>
            <p class="product-name">{p.nombre}</p>
            <dl class="product-data">
              {p.datos.map((d) => (
                <div>
                  <dt>{d.k[lang]}</dt>
                  <dd>{d.v[lang]}</dd>
                </div>
              ))}
              <div>
                <dt>{c.price}</dt>
                <dd>{p.precio[lang]}</dd>
              </div>
            </dl>
            <a class="buy" href={p.url} target="_blank" rel="noopener">
              {c.seeOn} {p.marca} <span aria-hidden="true">↗</span><NewTab />
            </a>
          </li>
        );
      })
    }
  </ul>
  <p class="note">{c.productsNote}</p>
</section>

<style>
  .products {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-2);
    border-top: 1px dashed var(--rule);
  }

  .heading {
    color: var(--lab);
  }

  /* auto-fill y no auto-fit: un producto solo no se estira a toda la ficha */
  .product-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* La foto a un lado y los datos al otro, como una muestra pegada en la
     ficha: con la foto encima ocupaba media pantalla (#77) */
  .product {
    display: grid;
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    gap: 6px var(--space-2);
    padding: var(--space-1);
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .photo {
    grid-row: 1 / -1;
    align-self: start;
    aspect-ratio: 1;
    overflow: hidden;
    background: #fff;
    border-radius: var(--radius);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--slow) var(--ease-out);
  }

  /* Solo con ratón: en el móvil se quedaba puesto tras tocar (#79) */
  @media (hover: hover) and (pointer: fine) {
    .product:hover .photo :global(img) {
      transform: scale(1.04);
    }
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .brand {
    color: var(--lab);
  }

  /* Para el enlace desde Mi espacio: que no quede bajo el borde de arriba */
  .product[id] {
    scroll-margin-block-start: var(--space-4);
  }

  .origin {
    color: var(--ink-soft);
  }

  .product-name {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.25;
  }

  .product-data {
    display: grid;
    gap: 4px;
    margin: 0;
    font-size: var(--step--1);
  }

  .product-data div {
    display: grid;
    grid-template-columns: 5.5em 1fr;
    gap: 0.5em;
  }

  .product-data dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.85em;
    text-transform: uppercase;
  }

  .product-data dd {
    margin: 0;
  }

  .buy {
    align-self: end;
    padding-block: 0.4rem;
    font-size: var(--step--1);
  }

  .note {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }


  /* Al final del problema: un recuadro como «Si quieres combinarlos», con la
     foto algo más grande */
  .bundle {
    padding: var(--space-2) var(--space-3);
    border: 1.5px solid var(--ink);
    border-top: 1.5px solid var(--ink);
    background: var(--sheet);
  }

  .bundle .product-list {
    grid-template-columns: 1fr;
  }

  .bundle .product {
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
  }

  .bundle .product-data div {
    grid-template-columns: 7.5em 1fr;
  }

  /* En móvil no caben las dos columnas: la foto va encima, pero pequeña */
  @media (max-width: 30rem) {
    .product,
    .bundle .product {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .photo {
      grid-row: auto;
      width: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo :global(img) {
      transition: none;
    }
  }
</style>
