---
// Rueda del ciclo menstrual para el problema del ciclo y la menopausia (#96): 28
// días en círculo, como el reloj del sueño, con la regla, la ovulación y la
// fase lútea, que es cuando aparece el síndrome premenstrual. Dentro, lo que se
// toma todo el ciclo; al lado, la menopausia, cuando el ciclo se para.
import rough from "roughjs";
import type { CompendioText } from "../../i18n/compendio";
import SketchMap, { type MapMarker, type SketchGroup } from "./SketchMap.astro";

interface Props {
  markers: MapMarker[];
  text: CompendioText["cycle"];
  thumb?: boolean;
}
const { markers, text, thumb = false } = Astro.props;

const C = 180;
const CY = 172;
const at = (day: number, r: number): [number, number] => {
  const a = ((day - 1) / 28) * 2 * Math.PI - Math.PI / 2;
  return [Math.round((C + r * Math.cos(a)) * 10) / 10, Math.round((CY + r * Math.sin(a)) * 10) / 10];
};
// Sector entre dos días (el segundo, sin incluir) y dos radios
const sector = (d0: number, d1: number, r0: number, r1: number) => {
  const big = d1 - d0 > 14 ? 1 : 0;
  const [a, b, c, d] = [at(d0, r1), at(d1, r1), at(d1, r0), at(d0, r0)];
  return `M${a} A${r1} ${r1} 0 ${big} 1 ${b} L${c} A${r0} ${r0} 0 ${big} 0 ${d} Z`;
};
const circle = (cx: number, cy: number, r: number) => `M${cx - r} ${cy} A${r} ${r} 0 1 1 ${cx + r} ${cy} A${r} ${r} 0 1 1 ${cx - r} ${cy} Z`;

const gen = rough.generator();
const toPath = (set: Parameters<typeof gen.opsToPath>[0]) =>
  gen.opsToPath(set).replace(/-?\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));
const base = { roughness: 1.1, bowing: 1, stroke: "currentColor", strokeWidth: 1.6 };
function draw(d: string, seed: number, fill = true) {
  const outline: string[] = [];
  const fills: string[] = [];
  const opts = fill ? { fill: "currentColor", fillStyle: "hachure", hachureGap: 6.5, fillWeight: 0.6, hachureAngle: -41 + seed * 7 } : {};
  for (const set of gen.path(d, { ...base, ...opts, seed }).sets) {
    if (set.type === "fillSketch") fills.push(toPath(set));
    else if (set.type === "path") outline.push(toPath(set));
  }
  return { outline, fills };
}
const line = (d: string, seed: number, strokeWidth = 1.1) => toPath(gen.path(d, { ...base, strokeWidth, seed }).sets[0]);

const R0 = 72;
const R1 = 122;
// La regla (días 1-5) va rayada como decoración; la fase lútea es la zona del SPM
const period = draw(sector(1, 6, R0, R1), 3);
const follicular = draw(sector(6, 14, R0, R1), 4, false);
const luteal = draw(sector(15, 29, R0, R1), 5);
const inner = draw(circle(C, CY, 58), 6);
const meno = draw("M314 252 L390 252 L390 330 L314 330 Z", 7);
// El óvulo el día 14, y una marca cada 7 días
const [ox, oy] = at(14.5, (R0 + R1) / 2);
const egg = draw(circle(ox, oy, 9), 8, false);
const ticks = [1, 8, 15, 22].map((d, i) => {
  const [x0, y0] = at(d, R1);
  const [x1, y1] = at(d, R1 + 10);
  return line(`M${x0} ${y0} L${x1} ${y1}`, 20 + i);
});

const groups: SketchGroup[] = [
  { outline: [...period.outline, ...follicular.outline, ...egg.outline], hachure: period.fills, details: ticks },
  { zone: "lutea", outline: luteal.outline, hachure: luteal.fills, details: [] },
  { zone: "ciclo", outline: inner.outline, hachure: inner.fills, details: [] },
  { zone: "menopausia", outline: meno.outline, hachure: meno.fills, details: [] },
];

const byZone: Record<string, number> = {};
const placed = markers.map((m) => {
  const k = byZone[m.zone] ?? 0;
  byZone[m.zone] = k + 1;
  const total = markers.filter((x) => x.zone === m.zone).length;
  if (m.zone === "lutea") {
    const [x, y] = at(21.5 + (k - (total - 1) / 2) * 3, (R0 + R1) / 2);
    return { ...m, x, y };
  }
  if (m.zone === "menopausia") return { ...m, x: 352, y: 290 + (k - (total - 1) / 2) * 28 };
  return { ...m, x: C + (k - (total - 1) / 2) * 28, y: CY + 8 };
});
const labels = [1, 8, 15, 22].map((d) => ({ d, xy: at(d, R1 + 24) }));
const [px, py] = at(3.2, (R0 + R1) / 2);
// La etiqueta de la fase lútea, arriba a la izquierda, fuera del anillo
const [lx, ly] = at(25.2, R1 + 22);
---

<SketchMap viewBox="0 0 400 344" idPrefix="ciclo" groups={groups} placed={placed} markers={markers} text={text} thumb={thumb}>
  <g class="names" font-size="11">
    {
      labels.map(({ d, xy }) => (
        <text x={xy[0]} y={xy[1] + 4} text-anchor="middle">
          {text.day} {d}
        </text>
      ))
    }
    <text x={px} y={py + 4} text-anchor="middle">{text.period}</text>
    <text x={ox + 14} y={oy - 12}>{text.ovulation}</text>
    <text x={C} y={CY - 20} text-anchor="middle">{text.zones.ciclo}</text>
    <text x={lx} y={ly} text-anchor="middle">{text.zones.lutea}</text>
    <text x="352" y="246" text-anchor="middle">{text.zones.menopausia}</text>
  </g>
</SketchMap>
