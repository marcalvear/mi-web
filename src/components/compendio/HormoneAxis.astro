---
// Eje de la testosterona para el problema de las hormonas masculinas (#95): el
// cerebro manda la señal (LH), los testículos fabrican la testosterona y la
// sangre la lleva, en parte pegada a una proteína (SHBG). Una flecha de vuelta
// recuerda que, si hay mucha, el cerebro frena la señal. Cada suplemento se
// coloca donde se cree que actúa, dibujado a mano alzada.
import rough from "roughjs";
import type { CompendioText } from "../../i18n/compendio";
import SketchMap, { type MapMarker, type SketchGroup } from "./SketchMap.astro";

interface Props {
  markers: MapMarker[];
  text: CompendioText["axis"];
  thumb?: boolean;
}
const { markers, text, thumb = false } = Astro.props;

const gen = rough.generator();
const toPath = (set: Parameters<typeof gen.opsToPath>[0]) =>
  gen.opsToPath(set).replace(/-?\d+\.\d+/g, (n) => String(Math.round(Number(n) * 10) / 10));
const base = { roughness: 1.1, bowing: 1, stroke: "currentColor", strokeWidth: 1.6 };
function draw(d: string, seed: number, fill = true) {
  const outline: string[] = [];
  const fills: string[] = [];
  const opts = fill ? { fill: "currentColor", fillStyle: "hachure", hachureGap: 6.5, fillWeight: 0.6, hachureAngle: -41 + seed * 7 } : {};
  for (const set of gen.path(d, { ...base, ...opts, seed }).sets) {
    if (set.type === "fillSketch") fills.push(toPath(set));
    else if (set.type === "path") outline.push(toPath(set));
  }
  return { outline, fills };
}
const line = (d: string, seed: number, strokeWidth = 1.2) => toPath(gen.path(d, { ...base, strokeWidth, seed }).sets[0]);
const ellipse = (cx: number, cy: number, rx: number, ry: number) =>
  `M${cx - rx} ${cy} A${rx} ${ry} 0 1 1 ${cx + rx} ${cy} A${rx} ${ry} 0 1 1 ${cx - rx} ${cy} Z`;

// Cerebro arriba, con dos surcos; testículos en medio; un vaso sanguíneo abajo
const brain = draw("M130 70 C118 40 150 18 180 24 C196 10 226 12 236 26 C266 20 286 44 272 70 C276 92 248 104 226 96 C212 108 184 106 172 96 C148 104 124 92 130 70 Z", 3);
const folds = [line("M164 40 C176 54 168 72 182 84", 4), line("M214 34 C206 52 224 66 214 86", 5), line("M244 50 C232 62 250 74 240 86", 6)];
const left = draw(ellipse(170, 166, 26, 32), 7);
const right = draw(ellipse(232, 166, 26, 32), 8);
const vessel = draw("M36 236 C120 228 280 228 364 236 L364 268 C280 276 120 276 36 268 Z", 9);
const cells = [0, 1, 2, 3, 4].map((i) => line(`M${70 + i * 64} 250 C${78 + i * 64} 244 ${90 + i * 64} 244 ${96 + i * 64} 252`, 30 + i));
// Flechas: LH hacia abajo, testosterona a la sangre y el freno de vuelta al cerebro
const arrows = [
  line("M201 108 L201 128", 10, 1.6),
  line("M195 122 L201 130 L207 122", 11),
  line("M201 200 L201 224", 12, 1.6),
  line("M195 218 L201 226 L207 218", 13),
  line("M356 230 C392 180 380 70 282 58", 14),
  line("M290 52 L280 58 L290 66", 15),
];

const groups: SketchGroup[] = [
  { zone: "cerebro", outline: brain.outline, hachure: brain.fills, details: folds },
  { zone: "testiculo", outline: [...left.outline, ...right.outline], hachure: [...left.fills, ...right.fills], details: [] },
  { zone: "sangre", outline: vessel.outline, hachure: vessel.fills, details: cells },
  { outline: [], hachure: [], details: arrows },
];

// Dónde va cada marcador; si hay varios en una zona, en fila
const anchors: Record<string, [number, number]> = { cerebro: [201, 62], testiculo: [201, 166], sangre: [200, 252] };
const byZone: Record<string, number> = {};
const placed = markers.map((m) => {
  const k = byZone[m.zone] ?? 0;
  byZone[m.zone] = k + 1;
  const total = markers.filter((x) => x.zone === m.zone).length;
  const [x, y] = anchors[m.zone] ?? [200, 150];
  const gap = m.zone === "testiculo" ? 62 : 30;
  return { ...m, x: x + (k - (total - 1) / 2) * gap, y };
});
---

<SketchMap viewBox="0 0 400 290" idPrefix="eje" groups={groups} placed={placed} markers={markers} text={text} thumb={thumb}>
  <g class="names" font-size="11">
    <text x="62" y="62">{text.zones.cerebro}</text>
    <text x="210" y="121">LH</text>
    <text x="62" y="170">{text.zones.testiculo}</text>
    <text x="210" y="216">{text.testosterone}</text>
    <text x="200" y="288" text-anchor="middle">{text.zones.sangre}</text>
    <text x="330" y="126" text-anchor="middle">{text.brake}</text>
  </g>
</SketchMap>
