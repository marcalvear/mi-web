---
// Una entrada del cuaderno: cada bloque de la página va numerado como en una
// libreta de laboratorio («Entrada 02 · Sobre mí»).
interface Props {
  id: string;
  number: number;
  kicker: string;
  title: string;
  /** Nota corta a la derecha del título: fecha, estado… */
  meta?: string;
  /** Si la entrada es la página entera (cada problema del compendio), el
      antetítulo hace de h1 y el título queda en h2, sin saltar niveles (#105) */
  page?: boolean;
}
const { id, number, kicker, title, meta, page = false } = Astro.props;
const Kicker = page ? "h1" : "p";
const n = String(number).padStart(2, "0");
---

<section class="entry" id={id} aria-labelledby={`${id}-title`}>
  <header class="entry-head">
    <Kicker class="label entry-kicker">
      <span class="num">{n}</span>
      <span>{kicker}</span>
    </Kicker>
    <h2 id={`${id}-title`}>{title}</h2>
    {meta && <p class="label meta">{meta}</p>}
  </header>
  <div class="entry-body">
    <slot />
  </div>
</section>

<style>
  /* Como h1 sigue pareciendo la etiqueta de siempre */
  h1.entry-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.06em;
  }

  .entry {
    padding-block: var(--space-6);
    border-top: 1px dashed var(--rule);
  }

  .entry-head {
    display: grid;
    gap: var(--space-1);
    margin-block-end: var(--space-4);
  }

  .num {
    display: inline-block;
    min-width: 2.6em;
    margin-inline-end: 0.6em;
    padding: 0.1em 0.45em;
    border: 1.5px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    text-align: center;
  }

  .meta {
    color: var(--ink-soft);
  }

  .entry-body > :global(* + *) {
    margin-block-start: var(--space-2);
  }
</style>
