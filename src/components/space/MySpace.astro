---
// Mi espacio (#31): el hilo de cada persona conmigo. Todo pasa en el
// navegador con la clave pública de Supabase; lo que protege los datos son
// las reglas RLS (ADR 0006). Aun así, cada consulta filtra por el id de quien
// ha entrado: el admin puede leer todos los hilos y aquí solo debe ver el suyo.
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";
import Button from "../Button.astro";
import { space } from "../../i18n/space";
import { compendio } from "../../i18n/compendio";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = space[lang];
const MAX = 5000;
const signIn = getRelativeLocaleUrl(lang, "entrar/");
const adminPanel = getRelativeLocaleUrl(lang, "panel/");
const id = (field: string) => `space-${field}-${lang}`;
// Las fichas del compendio, para pintar los favoritos (#67): en la base de
// datos solo está el id de cada ficha
const compendioUrl = getRelativeLocaleUrl(lang, "biohacking/");
const catalog = Object.fromEntries([
  ...(await getCollection("suplementos")).map((s) => [
    s.id,
    {
      name: s.data.nombre[lang],
      type: s.data.tipo[lang],
      evidence: c.favorites.evidence.replace("{level}", compendio[lang].evidence[s.data.evidencia].toLowerCase()),
      href: `${compendioUrl}#${s.id}`,
    },
  ]),
  // Y los productos que juntan varios suplementos, al final de cada problema (#81)
  ...(await getCollection("problemas")).flatMap((p) =>
    (p.data.productos ?? []).map((prod) => [
      prod.id,
      { name: prod.nombre, type: prod.marca, evidence: c.favorites.product, href: `${compendioUrl}#${prod.id}` },
    ]),
  ),
]);
---

<Base lang={lang} title={c.meta.title} description={c.meta.description} path="mi-espacio/" noindex>
  <div
    class="wrap"
    data-space
    data-lang={lang}
    data-max={MAX}
    data-text={JSON.stringify(c)}
    data-catalog={JSON.stringify(catalog)}
  >
    <header class="intro">
      <p class="label">{c.kicker}</p>
      <h1 data-title>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <noscript><p>{c.noscript}</p></noscript>
    <p class="label" data-panel="loading" hidden>{c.loading}</p>
    <p data-panel="setup" hidden>{c.setup}</p>

    <section class="card out" data-panel="out" hidden>
      <h2>{c.out.title}</h2>
      <p>{c.out.body}</p>
      <Button href={signIn}>{c.out.cta}</Button>
    </section>

    <div class="layout" data-panel="in" hidden>
      <div class="main">
        <section class="favorites" aria-labelledby={id("favorites")}>
          <header class="thread-head">
            <h2 id={id("favorites")}>{c.favorites.title}</h2>
            <p class="label" data-fav-count></p>
          </header>
          <p class="help" data-fav-lead>{c.favorites.lead}</p>
          <ul class="fav-list" role="list" data-fav-list></ul>
        <p class="empty" data-fav-empty hidden>
          {c.favorites.empty} <a href={compendioUrl}>{c.favorites.cta} <span aria-hidden="true">→</span></a>
        </p>
        </section>

        <section class="thread" aria-labelledby={id("thread")}>
          <header class="thread-head">
            <h2 id={id("thread")}>{c.thread.title}</h2>
            <p class="label" data-summary></p>
          </header>

          <ol class="messages" role="list" aria-label={c.thread.label} data-messages></ol>
          <p class="empty" data-empty hidden>{c.thread.empty}</p>

          <form class="compose" data-compose novalidate>
            <label class="label" for={id("body")}>{c.compose.label}</label>
            <textarea
              id={id("body")}
              name="body"
              rows="4"
              maxlength={MAX}
              required
              placeholder={c.compose.placeholder}
              aria-describedby={id("count")}
            />
            <div class="compose-foot">
              <p class="help" id={id("count")} data-count>
                {c.compose.count.replace("{n}", "0").replace("{max}", String(MAX))}
              </p>
              <Button type="submit" data-submit>{c.compose.submit}</Button>
            </div>
          </form>
          <p class="status" role="status" data-status></p>
        </section>
      </div>

      <aside class="card profile" aria-labelledby={id("profile")}>
        <p class="label tag" id={id("profile")}>{c.profile.label}</p>
        <dl class="facts">
          <div>
            <dt class="label">{c.profile.name}</dt>
            <dd>
              <span data-name></span>
              <button type="button" class="text-button" data-edit>{c.profile.edit}</button>
              <form class="name-form" data-name-form hidden>
                <label class="visually-hidden" for={id("name")}>{c.profile.name}</label>
                <input id={id("name")} name="name" type="text" maxlength="120" autocomplete="name" />
                <div class="row">
                  <Button type="submit" arrow={false}>{c.profile.save}</Button>
                  <button type="button" class="text-button" data-cancel>{c.profile.cancel}</button>
                </div>
              </form>
            </dd>
          </div>
          <div>
            <dt class="label">{c.profile.email}</dt>
            <dd data-email></dd>
          </div>
          <div>
            <dt class="label">{c.profile.since}</dt>
            <dd data-since></dd>
          </div>
        </dl>
        <p class="admin" data-admin hidden>{c.profile.admin} <a href={adminPanel}>{c.profile.panel}</a></p>
        <Button variant="ghost" arrow={false} data-signout>{c.profile.signOut}</Button>
      </aside>
    </div>
  </div>
</Base>

<script>
  import type { User } from "@supabase/supabase-js";
  import { supabase, type Message } from "../../lib/supabase";
  import type { SpaceText } from "../../i18n/space";

  type Panel = "loading" | "setup" | "out" | "in";
  type Shown = Pick<Message, "id" | "author" | "body" | "created_at" | "read_at">;
  type Sheet = { name: string; type: string; evidence: string; href: string };

  const root = document.querySelector<HTMLElement>("[data-space]");
  if (root) init(root);

  async function init(root: HTMLElement) {
    const t = JSON.parse(root.dataset.text!) as SpaceText;
    const catalog = JSON.parse(root.dataset.catalog!) as Record<string, Sheet>;
    const lang = root.dataset.lang!;
    const max = Number(root.dataset.max);
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
    const list = $<HTMLOListElement>("[data-messages]");
    const status = $("[data-status]");
    const compose = $<HTMLFormElement>("[data-compose]");
    const body = compose.elements.namedItem("body") as HTMLTextAreaElement;
    const submit = compose.querySelector<HTMLButtonElement>("[data-submit]")!;
    const nameForm = $<HTMLFormElement>("[data-name-form]");
    const nameInput = nameForm.elements.namedItem("name") as HTMLInputElement;

    const when = new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "short" });
    const day = new Intl.DateTimeFormat(lang, { dateStyle: "long" });
    let user: User;
    let messages: Shown[] = [];
    let favorites: string[] = [];

    function show(panel: Panel) {
      panels.forEach((p) => (p.hidden = p.dataset.panel !== panel));
    }

    function say(text = "", error = false) {
      status.textContent = text;
      status.classList.toggle("error", error);
    }

    // Cada mensaje es una entrada del cuaderno: quién, cuándo y el texto.
    // Todo va con textContent: lo que escribe la gente nunca se lee como HTML.
    function entry(m: Shown, isNew: boolean) {
      const li = document.createElement("li");
      li.className = `message ${m.author}`;
      const head = document.createElement("p");
      head.className = "label meta";
      const who = document.createElement("span");
      who.className = "who";
      who.textContent = m.author === "admin" ? t.thread.marc : t.thread.you;
      const time = document.createElement("time");
      time.dateTime = m.created_at;
      time.textContent = when.format(new Date(m.created_at));
      head.append(who, " · ", time);
      if (isNew) {
        const badge = document.createElement("span");
        badge.className = "new";
        badge.textContent = t.thread.new;
        head.append(" ", badge);
      }
      const text = document.createElement("p");
      text.className = "body";
      text.textContent = m.body;
      li.append(head, text);
      return li;
    }

    function render(unread: Set<number>) {
      list.replaceChildren(...messages.map((m) => entry(m, unread.has(m.id))));
      $("[data-empty]").hidden = messages.length > 0;
      const n = messages.length;
      const count = n === 1 ? t.thread.one : t.thread.count.replace("{n}", String(n));
      $("[data-summary]").textContent = unread.size
        ? `${count} · ${t.thread.unread.replace("{n}", String(unread.size))}`
        : count;
    }

    // Fichas guardadas (#67): la más reciente arriba
    function renderFavorites() {
      const n = favorites.length;
      $("[data-fav-empty]").hidden = n > 0;
      $("[data-fav-lead]").hidden = n === 0;
      $("[data-fav-count]").textContent = n === 1 ? t.favorites.one : t.favorites.count.replace("{n}", String(n));
      $("[data-fav-list]").replaceChildren(
        ...favorites.map((fav) => {
          const sheet = catalog[fav];
          const li = document.createElement("li");
          li.className = "fav";
          const info = document.createElement("div");
          if (sheet) {
            const link = document.createElement("a");
            link.href = sheet.href;
            link.className = "fav-name";
            link.textContent = sheet.name;
            const meta = document.createElement("p");
            meta.className = "label fav-meta";
            meta.textContent = `${sheet.type} · ${sheet.evidence}`;
            info.append(link, meta);
          } else {
            const name = document.createElement("p");
            name.className = "fav-name";
            name.textContent = fav;
            const meta = document.createElement("p");
            meta.className = "label fav-meta";
            meta.textContent = t.favorites.gone;
            info.append(name, meta);
          }
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "text-button";
          remove.textContent = t.favorites.remove;
          remove.setAttribute("aria-label", t.favorites.removeLabel.replace("{name}", sheet?.name ?? fav));
          remove.addEventListener("click", () => unsave(fav));
          li.append(info, remove);
          return li;
        }),
      );
    }

    async function unsave(fav: string) {
      const { error } = await supabase!.from("favorites").delete().eq("user_id", user.id).eq("supplement", fav);
      if (error) {
        say(t.errors.favorite, true);
        return;
      }
      favorites = favorites.filter((f) => f !== fav);
      renderFavorites();
      say(t.favorites.removed);
      log("favorito", { ficha: fav, accion: "quitar" });
      // El foco no se pierde al desaparecer el botón
      if (favorites.length) $<HTMLElement>("[data-fav-list] button").focus();
      else body.focus();
    }

    function showName(name: string | null) {
      $("[data-name]").textContent = name || t.profile.noName;
      $("[data-title]").textContent = name ? t.hello.replace("{name}", name) : t.title;
      nameInput.value = name ?? "";
    }

    // Queda en events para el panel de administrador (#32)
    function log(type: string, data: Record<string, string> = {}) {
      supabase!.from("events").insert({ user_id: user.id, type, data: { lang, ...data } }).then(() => {});
    }

    async function load() {
      const [profile, thread, favs] = await Promise.all([
        supabase!.from("profiles").select("name, email, role, created_at").eq("id", user.id).maybeSingle(),
        supabase!
          .from("messages")
          .select("id, author, body, created_at, read_at")
          .eq("user_id", user.id)
          .order("created_at", { ascending: true }),
        supabase!
          .from("favorites")
          .select("supplement")
          .eq("user_id", user.id)
          .order("created_at", { ascending: false }),
      ]);
      if (profile.error || thread.error || !profile.data) {
        show("in");
        say(t.errors.load, true);
        return;
      }

      showName(profile.data.name);
      $("[data-email]").textContent = profile.data.email;
      $("[data-since]").textContent = day.format(new Date(profile.data.created_at));
      $("[data-admin]").hidden = profile.data.role !== "admin";

      messages = thread.data;
      // Si falla, el espacio se ve igual, con la lista de favoritos vacía
      favorites = favs.data?.map((f) => f.supplement) ?? [];
      renderFavorites();
      // «Nuevo» en mis respuestas que aún no había leído; luego se marcan como leídas
      const unread = new Set(messages.filter((m) => m.author === "admin" && !m.read_at).map((m) => m.id));
      render(unread);
      show("in");
      if (unread.size) supabase!.rpc("mark_replies_read").then(() => {});
      log("mi_espacio");
    }

    // Escribir --------------------------------------------------------------
    body.addEventListener("input", () => {
      $("[data-count]").textContent = t.compose.count
        .replace("{n}", String(body.value.length))
        .replace("{max}", String(max));
    });

    function busy(on: boolean) {
      submit.disabled = on;
      const label = [...submit.childNodes].find((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim());
      if (label) label.textContent = on ? t.compose.sending : t.compose.submit;
    }

    compose.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = body.value.trim();
      if (!text) {
        say(t.errors.empty, true);
        body.focus();
        return;
      }
      say();
      busy(true);
      // RLS solo deja escribir en tu hilo y como autor «user»
      const { data, error } = await supabase!
        .from("messages")
        .insert({ user_id: user.id, author: "user", body: text })
        .select("id, author, body, created_at, read_at")
        .single();
      busy(false);
      if (error || !data) {
        say(t.errors.send, true);
        return;
      }
      messages.push(data);
      render(new Set());
      compose.reset();
      body.dispatchEvent(new Event("input"));
      say(t.compose.sent);
      list.lastElementChild?.scrollIntoView({ block: "nearest" });
      log("mensaje");
    });

    // Nombre ----------------------------------------------------------------
    const editButton = $<HTMLButtonElement>("[data-edit]");
    function editing(on: boolean) {
      nameForm.hidden = !on;
      editButton.hidden = on;
      $("[data-name]").hidden = on;
      if (on) nameInput.focus();
      else editButton.focus();
    }
    editButton.addEventListener("click", () => editing(true));
    $("[data-cancel]").addEventListener("click", () => editing(false));
    nameForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim() || null;
      // El trigger protect_profile solo deja cambiar el nombre
      const { error } = await supabase!.from("profiles").update({ name }).eq("id", user.id);
      if (error) {
        say(t.errors.name, true);
        return;
      }
      showName(name);
      editing(false);
      say(t.profile.saved);
    });

    $("[data-signout]").addEventListener("click", async () => {
      await supabase!.auth.signOut({ scope: "local" });
      show("out");
    });

    // Arranque --------------------------------------------------------------
    if (!supabase) return show("setup");
    show("loading");
    supabase.auth.onAuthStateChange((event) => {
      if (event === "SIGNED_OUT") show("out");
    });
    const { data } = await supabase.auth.getSession();
    if (!data.session) return show("out");
    user = data.session.user;
    await load();
  }
</script>

<style>
  /* Lo que se ve depende de la sesión y lo pinta JavaScript al cargar: con
     este alto mínimo el pie no salta cuando aparece (CLS) */
  .wrap {
    min-height: 80vh;
  }

  .intro {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-4);
  }

  .lead {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
  }

  /* Sin esto, los display de abajo ganarían al atributo hidden */
  [hidden] {
    display: none !important;
  }

  .card {
    padding: var(--space-4) var(--space-3);
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    box-shadow: 5px 5px 0 var(--rule);
  }

  .out {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    max-width: 36rem;
    margin-block-end: var(--space-7);
  }

  .out h2 {
    font-size: var(--step-2);
  }

  /* El hilo a la izquierda y la ficha a la derecha; en móvil, la ficha debajo */
  .layout {
    display: grid;
    gap: var(--space-5);
    margin-block-end: var(--space-7);
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }

    .profile {
      position: sticky;
      top: var(--space-4);
    }
  }

  .main {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .favorites {
    display: grid;
    gap: var(--space-2);
  }

  .fav-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  /* Cada favorito, una ficha pequeña con el margen verde del compendio */
  .fav-list :global(.fav) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--lab);
    background: var(--sheet);
  }

  .fav-list :global(.fav-name) {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .fav-list :global(.fav-meta) {
    color: var(--ink-soft);
  }

  /* Lo crea el script: sin :global no le llegarían los estilos de .text-button */
  .fav-list :global(.text-button) {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .thread-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block-end: var(--space-2);
    border-bottom: 1.5px solid var(--ink);
  }

  .thread-head h2 {
    font-size: var(--step-2);
  }

  .messages {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-3) 0;
    padding: 0;
  }

  /* Entradas del cuaderno: las mías con el rotulador rojo en el margen */
  .messages :global(.message) {
    max-width: 44rem;
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--ink);
    background: var(--sheet);
  }

  .messages :global(.message.admin) {
    justify-self: end;
    border-left-color: var(--accent);
    box-shadow: 3px 3px 0 var(--rule);
  }

  .messages :global(.meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    color: var(--ink-soft);
  }

  .messages :global(.message.admin .who) {
    color: var(--accent);
  }

  .messages :global(.new) {
    padding: 0.1em 0.5em;
    border-radius: var(--radius);
    background: var(--mark);
    color: var(--ink);
  }

  .messages :global(.body) {
    margin-block-start: 0.4rem;
    max-width: none;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .empty {
    margin-block: var(--space-3);
    color: var(--ink-soft);
    font-style: italic;
  }

  .compose {
    display: grid;
    gap: 0.4rem;
    padding-block-start: var(--space-3);
    border-top: 1px dashed var(--rule);
  }

  textarea,
  input {
    width: 100%;
    min-height: 48px;
    padding: 0.6rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
    line-height: 1.6;
  }

  .compose-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .help {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .status {
    margin-block-start: var(--space-2);
    color: var(--ink-soft);
    font-style: italic;
  }

  .status:empty {
    display: none;
  }

  .status.error {
    color: var(--accent);
  }

  .profile {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .tag {
    color: var(--accent);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }

  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .name-form {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-1);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .text-button {
    min-height: 44px;
    margin-inline-start: 0.5em;
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .admin {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-style: italic;
  }
</style>
