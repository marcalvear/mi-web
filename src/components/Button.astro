---
// Enlace con aspecto de botón. «primary» es el rotulador rojo y solo debe
// haber uno por pantalla; «ghost» es tinta sobre papel.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "ghost";
}
const { variant = "primary", class: className, ...rest } = Astro.props;
---

<a class:list={["button", variant, className]} {...rest}>
  <slot />
  <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true">
    <path d="M0 6h16M11 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    min-height: 48px;
    padding: 0.7rem 1.25rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    /* Sombra dura, como una tarjeta pegada en la libreta */
    box-shadow: 3px 3px 0 var(--ink);
    transition:
      transform var(--fast) var(--ease-out),
      box-shadow var(--fast) var(--ease-out);
  }

  .primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .ghost {
    background: var(--sheet);
    color: var(--ink);
  }

  .button:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .button:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .arrow {
    transition: transform var(--fast) var(--ease-out);
  }

  .button:hover .arrow {
    transform: translateX(3px);
  }
</style>
