---
// La «M» de Marc dibujada como un diagrama de flujo: cinco nodos unidos,
// igual que los flujos de IA que monto. Usa currentColor para heredar la tinta.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={["logo", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <polyline
    points="5,25 10.5,8 16,19 21.5,8 27,25"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linejoin="round"
    stroke-linecap="round"></polyline>
  <circle cx="5" cy="25" r="3" fill="var(--paper)" stroke="currentColor" stroke-width="2"></circle>
  <circle cx="10.5" cy="8" r="3" fill="currentColor"></circle>
  <circle class="logo-core" cx="16" cy="19" r="3.25" fill="var(--accent)"></circle>
  <circle cx="21.5" cy="8" r="3" fill="currentColor"></circle>
  <circle cx="27" cy="25" r="3" fill="var(--paper)" stroke="currentColor" stroke-width="2"></circle>
</svg>
