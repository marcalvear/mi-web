# Copia este fichero como .env y rellénalo (el .env no se sube a git).
# Los dos valores están en Supabase → Project Settings → API Keys / Data API.
#
# Son públicos: acaban en el JavaScript de la web y lo que protege los datos
# son las reglas RLS. La clave secreta (service_role o sb_secret_…) NO va
# aquí: se salta las reglas y solo la usa n8n.
#
# En GitHub Pages los pone el workflow desde las variables del repositorio
# (Settings → Secrets and variables → Actions → Variables).

PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_o_clave_anon

# Formulario de contacto (#30). También públicos: la URL del webhook de n8n
# (Production URL del nodo «Formulario de la web») y la clave de SITIO de
# Cloudflare Turnstile. La clave SECRETA de Turnstile va solo en n8n.
# En local, sin clave de sitio, se usa la de pruebas de Cloudflare.
PUBLIC_N8N_CONTACT_URL=https://tu-instancia.app.n8n.cloud/webhook/mi-web/contacto
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_clave_de_sitio
